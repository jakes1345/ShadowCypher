:8080 {
    root * /srv

    # Reverse proxy for chat API to backend (uses Fly internal DNS for inter-app communication)
    @api_chat path /api/chat/*
    handle @api_chat {
        uri strip_prefix /api/chat
        reverse_proxy http://shadowcypher-chat.internal:8000 {
            # Allow proxy to fail gracefully if backend is starting up
            unhealthy_status 500 502 503
            unhealthy_latency 5s
        }
    }

    # SPA routing - serve index.html for all routes except static assets
    try_files {path} {path}/ /index.html

    # Serve static files with cache headers
    file_server {
        disable_canonical_uris
    }

    # Security headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.shadowcypher.site wss://api.shadowcypher.site https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none';"
    }

    # Compression
    encode gzip
}
