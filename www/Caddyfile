:8080 {
    root * /srv

    # Reverse proxy for chat API to backend (uses Fly internal DNS for inter-app communication)
    reverse_proxy /api/chat/* http://shadowcypher-chat.internal:8000 {
        uri strip_prefix /api/chat
    }

    # SPA routing - serve index.html for all routes except static assets
    try_files {path} {path}/ /index.html

    # Serve static files with cache headers
    file_server {
        disable_canonical_uris
    }

    # Security headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    # Compression
    encode gzip
}
