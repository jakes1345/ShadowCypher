/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://api.shadowcypher.site wss://api.shadowcypher.site https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none';

# The marketing homepage has no inline scripts. Browsers enforce both policies,
# so this one only needs to narrow script-src.
/
  Content-Security-Policy: script-src 'self'; object-src 'none'; base-uri 'self'

# On the live domain Cloudflare adds a bot-check script to every page, and that
# script sets a cookie. The privacy policy says the site sets none. Browsers
# enforce every policy they are sent, so this one names the only places a script
# may load from on the live site, and the bot check is not among them.
# /cdn-cgi/scripts/ stays: it holds Cloudflare's helper that shows the email
# addresses it hides from scrapers. A page that loads a script from a new
# folder must add the folder here (site_policy.test.ts fails until it does).
https://shadowcypher.site/*
  Content-Security-Policy: script-src 'unsafe-inline' 'wasm-unsafe-eval' https://shadowcypher.site/js/ https://shadowcypher.site/vendor/ https://shadowcypher.site/sw.js https://shadowcypher.site/cdn-cgi/scripts/
