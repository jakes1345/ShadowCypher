        <item name="colorPrimary">#b44aff</item>
        <item name="colorPrimaryVariant">#2a1040</item>
        <item name="colorOnPrimary">#f8fafc</item>
        <item name="colorSurface">#111113</item>
        <item name="colorOnSurface">#f8fafc</item>
        <item name="android:colorBackground">#09090b</item>
        <item name="colorOnBackground">#f8fafc</item>
