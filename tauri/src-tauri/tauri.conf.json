{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShadowCypher",
  "version": "3.0.0",
  "identifier": "site.shadowcypher.app",
  "build": {
    "frontendDist": "../../www"
  },
  "app": {
    "windows": [
      {
        "title": "ShadowCypher",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src https://api.shadowcypher.site wss://api.shadowcypher.site https://supabase.co; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {},
    "externalBin": [],
    "copyright": "© 2025 ShadowCypher",
    "category": "Utility",
    "shortDescription": "Secure encrypted comms platform",
    "longDescription": "ShadowCypher — end-to-end encrypted chat, mail, and file sharing for teams and individuals.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": null,
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
