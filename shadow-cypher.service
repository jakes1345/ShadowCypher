[Unit]
Description=ShadowCypher Router Admin Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jack
WorkingDirectory=/home/jack/ShadowCypher
ExecStart=/usr/bin/node /home/jack/ShadowCypher/server.js
Restart=always
RestartSec=10

# Environment
Environment=NODE_ENV=production
Environment=PORT=3000

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/jack/ShadowCypher

[Install]
WantedBy=multi-user.target
