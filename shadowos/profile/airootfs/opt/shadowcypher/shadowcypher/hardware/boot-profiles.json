{
  "version": "1.0",
  "metadata": {
    "name": "ShadowCypher Boot Configuration Profiles",
    "description": "Hardware-specific boot configurations for secure UEFI/BIOS deployment",
    "last_updated": "2026-07-05",
    "maintainer": "ShadowCypher Security Team"
  },
  "profiles": {
    "enterprise-server": {
      "name": "Enterprise Server",
      "description": "High-security datacenter deployments with full TPM2.0 support",
      "hardware_class": "server",
      "security_level": 4,
      "uefi": {
        "secure_boot": {
          "enabled": true,
          "mode": "standard",
          "enforce": true,
          "signature_algorithm": "sha256"
        },
        "tpm": {
          "enabled": true,
          "version": "2.0",
          "pcr_banking": "sha256",
          "sealed_secrets": true
        },
        "memory_protection": {
          "nx_bit_enabled": true,
          "execute_disable": true
        },
        "iommu": {
          "enabled": true,
          "vt_d_or_amd_vi": true
        },
        "secure_boot_keys": {
          "load_defaults": true,
          "custom_keys_allowed": false,
          "key_rotation_days": 365
        },
        "boot_timeout_seconds": 5,
        "boot_next_enabled": false,
        "allow_usb_boot": false,
        "allow_network_boot": true,
        "network_boot_timeout_seconds": 3
      },
      "bios_settings": {
        "password_enabled": true,
        "password_strength": "strong",
        "boot_device_order": [
          "internal_storage",
          "pxe_network"
        ],
        "allow_runtime_changes": false
      },
      "firmware": {
        "required_version_min": "2024.01",
        "rollback_protection": true,
        "update_strategy": "automated_with_validation",
        "signature_verification": true
      },
      "kernel_parameters": [
        "intel_iommu=on",
        "amd_iommu=on",
        "noexec=on",
        "efi=runtime",
        "efi_no_storage_paranoia",
        "module.sig_enforce=1",
        "apparmor=1",
        "security=apparmor"
      ],
      "attestation": {
        "tpm_quotes": true,
        "pcr_validation": [0, 1, 2, 4, 5, 6, 7],
        "remote_attestation": true,
        "audit_logging": true
      }
    },
