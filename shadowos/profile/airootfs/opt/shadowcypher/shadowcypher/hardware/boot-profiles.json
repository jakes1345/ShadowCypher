  "tpm_configurations": {
    "tpm_2_0": {
      "specification": "TCG TPM 2.0 Library Specification",
      "algorithms": [
        "SHA-1",
        "SHA-256",
        "SHA-384",
        "SHA-512"
      ],
      "supported_pcr_banks": [
        "sha1",
        "sha256",
        "sha384",
        "sha512"
      ],
      "default_pcr_bank": "sha256",
      "recommended_pcr_indices": [0, 1, 2, 4, 5, 6, 7],
      "pcr_purposes": {
        "0": "SRTM, POST-BIOS, Embedded BIOS",
        "1": "POST memory timing",
        "2": "Loaded BIOS option ROMs and GPDs",
        "3": "BIOS configuration",
        "4": "Boot Loader Code and GPDs",
        "5": "Boot Loader Configuration and Data",
        "6": "Host Platform Manufacturer Specific",
        "7": "Secure Launch Control Policy",
        "8": "Kernel and Initrd",
        "9": "System Firmware Data",
        "10": "Entity and Device Firmware"
      }
    },
    "tpm_1_2": {
      "specification": "TCG TPM 1.2 Rev 103",
      "algorithms": [
        "SHA-1"
      ],
      "pcr_count": 24,
      "default_algorithm": "sha1",
      "supported_hash_algorithm": "sha1"
    }
  },
  "validation_rules": {
    "enterprise_server_checks": [
      {
        "id": "secure_boot_enabled",
        "name": "Secure Boot is enabled",
        "severity": "critical",
        "check": "efibootmgr -p 2>/dev/null | grep -q 'Secure Boot: enabled'"
      },
      {
        "id": "tpm2_present",
        "name": "TPM 2.0 is present and enabled",
        "severity": "critical",
        "check": "tpm2_getcap handles-persistent | grep -q 0x8100"
      },
      {
        "id": "vt_d_enabled",
        "name": "VT-d/IOMMU is enabled",
        "severity": "high",
        "check": "grep -q 'IOMMU enabled' /sys/firmware/dmi/entries/*/raw 2>/dev/null || dmesg | grep -i 'IOMMU enabled'"
      },
      {
        "id": "bios_password_set",
        "name": "BIOS password is configured",
        "severity": "high",
        "check": "system_status | grep 'BIOS Password' | grep -q 'enabled'"
      },
      {
        "id": "nx_bit_enabled",
        "name": "NX bit is enabled",
        "severity": "high",
        "check": "grep -q ' nx ' /proc/cpuinfo"
      }
    ],
    "workstation_checks": [
      {
        "id": "secure_boot_enabled",
        "name": "Secure Boot is enabled",
        "severity": "high",
        "check": "efibootmgr -p 2>/dev/null | grep -q 'Secure Boot: enabled'"
      },
      {
        "id": "tpm2_present",
        "name": "TPM 2.0 is present",
        "severity": "high",
        "check": "tpm2_getcap handles-persistent | grep -q 0x8100"
      },
      {
        "id": "nx_bit_enabled",
        "name": "NX bit is enabled",
        "severity": "medium",
        "check": "grep -q ' nx ' /proc/cpuinfo"
      }
    ],
    "all_systems_checks": [
      {
        "id": "uefi_firmware_present",
        "name": "UEFI firmware is present",
        "severity": "critical",
        "check": "[ -d /sys/firmware/efi ]"
      },
      {
        "id": "efi_vars_accessible",
        "name": "UEFI variables are accessible",
        "severity": "high",
        "check": "[ -d /sys/firmware/efi/efivars ] || [ -d /sys/firmware/efi/fw_platform_size ]"
      }
    ]
  },
  "boot_variables": {
    "BootOrder": {
      "description": "Defines the order of boot devices",
      "type": "efi_uint16_list",
      "access": "read_write"
    },
    "BootCurrent": {
      "description": "Currently executing boot entry number",
      "type": "efi_uint16",
      "access": "read_only"
    },
    "BootNext": {
      "description": "Next boot entry on single boot",
      "type": "efi_uint16",
      "access": "read_write"
    },
    "BootOptionSupport": {
      "description": "Firmware capabilities and supported boot options",
      "type": "efi_uint32",
      "access": "read_only"
    },
    "SecureBootEnable": {
      "description": "Secure Boot enable status",
      "type": "efi_uint8",
      "access": "read_write"
    },
    "SetupMode": {
      "description": "Indicates Secure Boot setup state",
      "type": "efi_uint8",
      "access": "read_only"
    },
    "db": {
      "description": "Signature Database (authorized signatures)",
      "type": "efi_signature_database",
      "access": "read_write"
    },
    "dbx": {
      "description": "Exclusion Database (revoked signatures)",
      "type": "efi_signature_database",
      "access": "read_write"
    },
    "KEK": {
      "description": "Key Exchange Key",
      "type": "efi_signature_database",
      "access": "read_write"
    },
    "PK": {
      "description": "Platform Key",
      "type": "efi_signature_database",
      "access": "read_write"
    }
  },
  "firmware_update_policy": {
    "validation_required": true,
    "signature_verification": true,
    "rollback_check": true,
    "backup_previous": true,
    "recovery_strategy": "usb_recovery_media",
    "maximum_rollback_versions": 1,
    "update_notification_days": 7
  }
}
