{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "raw",
    "source": "\u001b[38;2;0;224;164m   ███████ ██   ██  █████  ██████   ██████  ██     ██\n   ██      ██   ██ ██   ██ ██   ██ ██    ██ ██     ██\n   ███████ ███████ ███████ ██   ██ ██    ██ ██  █  ██\n        ██ ██   ██ ██   ██ ██   ██ ██    ██ ██ ███ ██\n   ███████ ██   ██ ██   ██ ██████   ██████   ███ ███\u001b[0m\n   \u001b[38;2;107;119;133msecure  ·  private  ·  sovereign\u001b[0m\n",
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": "  │  ",
    "color": {
      "keys": "38;2;0;224;164",
      "title": "38;2;230;237;243"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "os       "
    },
    {
      "type": "kernel",
      "key": "kernel   "
    },
    {
      "type": "uptime",
      "key": "uptime   "
    },
    {
      "type": "de",
      "key": "de       "
    },
    {
      "type": "wm",
      "key": "wm       "
    },
    {
      "type": "shell",
      "key": "shell    "
    },
    {
      "type": "terminal",
      "key": "terminal "
    },
    {
      "type": "cpu",
      "key": "cpu      "
    },
    {
      "type": "gpu",
      "key": "gpu      "
    },
    {
      "type": "memory",
      "key": "memory   "
    },
    {
      "type": "disk",
      "key": "disk     "
    },
    {
      "type": "command",
      "key": "mode     ",
      "text": "cat /var/lib/shadowos/current-mode 2>/dev/null || echo normal"
    },
    {
      "type": "command",
      "key": "tor      ",
      "text": "systemctl is-active tor 2>/dev/null || echo inactive"
    },
    "break"
  ]
}
