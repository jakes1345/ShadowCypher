[Unit]
Description=ShadowCypher daemon (scans, incidents, CVE feed, AI)
Documentation=https://shadowcypher.site/docs
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/shadowcypher-daemon
WorkingDirectory=%h
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shadowcypher-daemon

[Install]
WantedBy=graphical-session.target
