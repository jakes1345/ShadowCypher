[Unit]
Description=ShadowOS first-boot setup (Chaotic-AUR, ghostty, librewolf, themes)
After=graphical.target network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/shadowos/firstboot.stamp

[Service]
Type=oneshot
ExecStart=/usr/local/bin/shadowos-firstboot
RemainAfterExit=yes
TimeoutStartSec=900

[Install]
WantedBy=graphical.target
