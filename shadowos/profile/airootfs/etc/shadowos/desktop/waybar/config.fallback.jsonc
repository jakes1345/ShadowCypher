{
  "layer": "top",
  "position": "bottom",
  "height": 40,
  "margin-bottom": 4,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["network", "pulseaudio", "tray"],

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "persistent_workspaces": { "*": 5 }
  },

  "clock": {
    "interval": 1,
    "format": "{:%H:%M}",
    "format-alt": "{:%a %b %d  %H:%M}"
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "  {ifname}",
    "format-disconnected": "  No network",
    "interval": 5,
    "on-click": "foot -e nmtui"
  },

  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "Muted",
    "on-click": "pavucontrol"
  },

  "tray": {
    "spacing": 8,
    "icon-size": 16
  }
}
