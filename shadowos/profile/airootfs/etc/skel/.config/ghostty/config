# ghostty — ShadowOS default terminal config (omarchy-inspired)
# https://ghostty.org/docs/config

# === Appearance ===
theme = dark:catppuccin-mocha,light:catppuccin-latte
background = #0D1B2A
foreground = #CDD6F4
font-family = JetBrainsMono Nerd Font
font-size = 13
font-thicken = true

# Cursor
cursor-style = block
cursor-style-blink = false

# Window chrome
window-decoration = false
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true

# Tabs and splits
gtk-tabs-location = bottom

# Background transparency (like omarchy's setup)
background-opacity = 0.96
background-blur-radius = 20

# === Colors (ShadowOS dark palette) ===
palette = 0=#1E2D40
palette = 1=#FF4444
palette = 2=#00E0A4
palette = 3=#FFDD00
palette = 4=#00B988
palette = 5=#FF8C42
palette = 6=#00E5FF
palette = 7=#CDD6F4
palette = 8=#2E3D50
palette = 9=#FF6B6B
palette = 10=#50E0B0
palette = 11=#FFE566
palette = 12=#00C99A
palette = 13=#FFA566
palette = 14=#40EBFF
palette = 15=#FFFFFF

# === Shell / UX ===
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# Scrollback
scrollback-limit = 100000

# Copy on select (omarchy default)
copy-on-select = clipboard

# Close confirmation — ask if there's a running process
confirm-close-surface = true

# Mouse hide while typing
mouse-hide-while-typing = true

# === Keybinds (omarchy-style: Ctrl+Shift+T/W for tabs) ===
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+f=toggle_fullscreen
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
