{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["custom/gamemode", "temperature", "cpu", "memory", "battery", "tray"],

  "hyprland/workspaces": { "format": "{id}", "on-click": "activate" },
  "hyprland/window": { "max-length": 40 },
  "clock": { "format": "{:%H:%M}", "tooltip": false },
  "cpu": { "format": "CPU {usage}%", "interval": 2 },
  "memory": { "format": "RAM {used:0.1f}G", "interval": 5 },
  "temperature": { "format": "{temperatureC}°C", "critical-threshold": 85 },
  "battery": { "format": "{capacity}% {icon}", "format-icons": ["","","","",""] },
  "tray": { "spacing": 6 },
  "custom/gamemode": {
    "exec": "echo '⚡ GAMING'",
    "interval": "once",
    "format": "{}"
  }
}
