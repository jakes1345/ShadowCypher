{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 4,
  "margin-top": 8,
  "margin-left": 14,
  "margin-right": 14,

  "modules-left":   ["custom/logo", "hyprland/workspaces", "custom/mode", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right":  ["custom/shadowcypher", "custom/steam", "custom/discord", "tray", "network", "pulseaudio", "battery", "custom/power"],

  "custom/logo": {
    "format": "  S  ",
    "tooltip": false,
    "on-click": "wofi --show drun"
  },

  "custom/mode": {
    "exec": "shadow-mode status 2>/dev/null | head -1",
    "interval": 5,
    "format": "  {}",
    "tooltip": true,
    "tooltip-format": "Click to switch ShadowOS personality",
    "on-click": "shadow-mode picker"
  },

  "custom/shadowcypher": {
    "format": "",
    "tooltip-format": "Open ShadowCypher",
    "on-click": "/opt/shadowcypher/launch.sh"
  },

  "custom/steam": {
    "format": "",
    "tooltip-format": "Steam",
    "on-click": "steam-runtime"
  },

  "custom/discord": {
    "format": "",
    "tooltip-format": "Discord",
    "on-click": "discord"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "1": "", "2": "", "3": "", "4": "", "5": "",
      "6": "", "7": "", "8": "", "9": "",
      "active": "",
      "default": ""
    },
    "persistent-workspaces": { "*": 5 }
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 70,
    "rewrite": { "(.*) — (.*)": "$1" }
  },

  "clock": {
    "interval": 1,
    "format": "{:%H:%M}",
    "format-alt": "{:%a · %b %d · %H:%M:%S}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },

  "tray": { "spacing": 8 },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "  wired",
    "format-disconnected": "  offline",
    "tooltip-format": "{ifname} · {ipaddr}",
    "on-click": "kitty -e nmtui"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "  mute",
    "format-icons": { "default": ["", "", ""] },
    "on-click": "pavucontrol"
  },

  "battery": {
    "format": "{icon}  {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "format-charging": "  {capacity}%",
    "states": { "warning": 25, "critical": 10 }
  },

  "custom/power": {
    "format": " ",
    "on-click": "wofi --show drun --search power",
    "tooltip": false
  }
}
