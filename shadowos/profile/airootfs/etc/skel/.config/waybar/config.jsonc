{
  "layer": "top",
  "position": "bottom",
  "height": 48,
  "spacing": 4,
  "margin-bottom": 8,
  "margin-left": 12,
  "margin-right": 12,

  "modules-left": [
    "custom/logo",
    "custom/spacer-s",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "wlr/taskbar"
  ],
  "modules-right": [
    "custom/shadowcypher",
    "custom/spacer-s",
    "custom/updates",
    "tray",
    "custom/spacer-s",
    "network",
    "pulseaudio",
    "battery",
    "custom/spacer-s",
    "clock",
    "custom/spacer-s",
    "custom/settings",
    "custom/power"
  ],

  "custom/logo": {
    "format": "󰘢",
    "tooltip-format": "Launch apps  ·  SUPER+D",
    "on-click": "wofi --show drun"
  },

  "custom/spacer-s": {
    "format": " "
  },

  "custom/shadowcypher": {
    "format": "󱐋",
    "tooltip-format": "ShadowCypher  ·  SUPER+S",
    "on-click": "env SHADOWCYPHER_MANUAL=1 /usr/local/bin/shadowcypher-autostart --manual"
  },

  "custom/updates": {
    "exec": "/usr/local/bin/shadow-update-count",
    "interval": 900,
    "return-type": "json",
    "format": "{}",
    "on-click": "foot --title 'shadow-update' -e bash -lc 'shadow-update; echo; read -n1 -rp \"Press any key…\"'",
    "on-click-right": "foot --title 'shadow-update --check' -e bash -lc 'shadow-update --check; echo; read -n1 -rp \"Press any key…\"'",
    "tooltip": true
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "persistent_workspaces": { "*": 5 },
    "active-only": false
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 22,
    "icon-theme": "Papirus-Dark",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "minimize",
    "ignore-list": []
  },

  "clock": {
    "interval": 1,
    "format": "{:%H:%M}",
    "format-alt": "{:%a %b %d  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },

  "tray": {
    "spacing": 8,
    "icon-size": 18,
    "show-passive-items": true
  },

  "network": {
    "format-wifi": "󰤨  {essid}",
    "format-ethernet": "󰈀  {ifname}",
    "format-disconnected": "󰤭  No network",
    "tooltip-format": "{ifname}  ·  {ipaddr}\n{bandwidthDownBytes}↓  {bandwidthUpBytes}↑",
    "interval": 5,
    "on-click": "nm-connection-editor",
    "on-click-right": "foot -e nmtui"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  Muted",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "tooltip-format": "{desc}  ·  {volume}%"
  },

  "battery": {
    "format": "{icon}  {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰚥  {capacity}%",
    "states": { "warning": 25, "critical": 10 },
    "tooltip-format": "{capacity}%  ·  {timeTo}"
  },

  "custom/settings": {
    "format": "󰒓",
    "tooltip-format": "Settings  ·  SUPER+I",
    "on-click": "/usr/local/bin/shadow-settings"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Power & session",
    "on-click": "bash -c 'choice=$(printf \"󰒲 Suspend\\n󰜉 Reboot\\n⏻ Shutdown\\n󰍃 Logout\" | wofi --dmenu --prompt \"Power\" --lines 4 --width 200) && case \"$choice\" in *Suspend*) systemctl suspend ;; *Reboot*) systemctl reboot ;; *Shutdown*) systemctl poweroff ;; *Logout*) hyprctl dispatch exit ;; esac'"
  }
}
