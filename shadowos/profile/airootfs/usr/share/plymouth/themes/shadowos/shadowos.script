// ShadowOS Plymouth boot animation
// — Tiled hex backdrop + centered S monogram + 12-dot orbit spinner
// — Logo pulses gently (alpha 0.85 → 1.0)
// — LUKS password prompt slides in cleanly
//
// Plymouth script reference: https://www.freedesktop.org/wiki/Software/Plymouth/Scripts/

// ── Setup ───────────────────────────────────────────────────────────────────
Window.SetBackgroundTopColor   (0.020, 0.027, 0.036);
Window.SetBackgroundBottomColor(0.020, 0.027, 0.036);

screen.width  = Window.GetWidth();
screen.height = Window.GetHeight();

// ── Background image (tiles or scales) ──────────────────────────────────────
bg.image      = Image("background.png");
bg.scaled     = bg.image.Scale(screen.width, screen.height);
bg.sprite     = Sprite(bg.scaled);
bg.sprite.SetX(0);
bg.sprite.SetY(0);
bg.sprite.SetZ(-100);

// ── Glow halo (behind logo, soft pulse) ─────────────────────────────────────
glow.image  = Image("logo-glow.png");
glow.sprite = Sprite(glow.image);
glow.x = screen.width / 2 - glow.image.GetWidth() / 2;
glow.y = screen.height / 2 - glow.image.GetHeight() / 2 - 40;
glow.sprite.SetX(glow.x);
glow.sprite.SetY(glow.y);
glow.sprite.SetZ(-2);
glow.sprite.SetOpacity(0.0);

// ── Main logo ───────────────────────────────────────────────────────────────
logo.image  = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = screen.width / 2 - logo.image.GetWidth() / 2;
logo.y = screen.height / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetX(logo.x);
logo.sprite.SetY(logo.y);
logo.sprite.SetZ(0);
logo.sprite.SetOpacity(0.0);

// ── 12-dot orbit ring around the logo ──────────────────────────────────────
dot.image = Image("dot.png");
orbit.radius = logo.image.GetWidth() / 2 + 50;
orbit.count = 12;

for (i = 0; i < orbit.count; i++) {
    dots[i].sprite = Sprite(dot.image);
    dots[i].sprite.SetZ(1);
    dots[i].sprite.SetOpacity(0.0);
}

// Phase used by Refresh()
phase = 0.0;

// ── Animation loop ──────────────────────────────────────────────────────────
fun Refresh() {
    phase = phase + 0.022;   // ~24Hz at 25fps refresh

    // Fade-in once (over ~1s)
    fade_in = phase * 1.2;
    if (fade_in > 1.0) fade_in = 1.0;
    logo.sprite.SetOpacity(fade_in);

    // Logo subtle breathing: alpha 0.85 → 1.0
    breathe = 0.925 + 0.075 * Math.Cos(phase * 1.4);
    if (fade_in == 1.0) logo.sprite.SetOpacity(breathe);

    // Glow halo pulses opposite (0.0 → 0.55)
    glow_alpha = 0.30 + 0.25 * Math.Cos(phase * 1.4 + 3.14);
    if (glow_alpha < 0.0) glow_alpha = 0.0;
    glow.sprite.SetOpacity(glow_alpha * fade_in);

    // Rotate the 12 dots, fading each by orbital position so the leading edge is brightest
    cx = screen.width / 2;
    cy = screen.height / 2 - 40;
    for (i = 0; i < orbit.count; i++) {
        // Each dot is offset by i/count of a turn; phase shifts all
        angle = phase * 2.0 + (i * 6.2831853 / orbit.count);
        dx = orbit.radius * Math.Cos(angle);
        dy = orbit.radius * Math.Sin(angle);
        dots[i].sprite.SetX(cx + dx - dot.image.GetWidth() / 2);
        dots[i].sprite.SetY(cy + dy - dot.image.GetHeight() / 2);
        // Fade by position — leading dot bright, trailing dots dim
        // (angle relative to "12 o'clock" position)
        rel = (i * 1.0) / orbit.count;
        alpha = 0.15 + 0.85 * (1.0 - rel);
        dots[i].sprite.SetOpacity(alpha * fade_in);
    }
}

Plymouth.SetRefreshFunction(Refresh);

// ── Status / boot messages (small, bottom-left) ─────────────────────────────
status.x = 40;
status.y = screen.height - 60;

fun DisplayMessage(text) {
    if (status.sprite) status.sprite.SetOpacity(0);
    status.image  = Image.Text(text, 0.42, 0.46, 0.52, 1.0, "Sans 11");
    status.sprite = Sprite(status.image);
    status.sprite.SetPosition(status.x, status.y, 5);
}
fun HideMessage() {
    if (status.sprite) status.sprite.SetOpacity(0);
}
Plymouth.SetDisplayMessageFunction(DisplayMessage);
Plymouth.SetHideMessageFunction(HideMessage);

// ── Password prompt (LUKS unlock) ───────────────────────────────────────────
fun DisplayPasswordPrompt(prompt, bullets) {
    // Hide spinner while user types
    for (i = 0; i < orbit.count; i++) dots[i].sprite.SetOpacity(0);

    // Prompt text
    if (prompt_label.sprite) prompt_label.sprite.SetOpacity(0);
    prompt_label.image  = Image.Text(prompt, 0.90, 0.93, 0.95, 1.0, "Sans 13");
    prompt_label.sprite = Sprite(prompt_label.image);
    prompt_label.sprite.SetPosition(
        screen.width / 2 - prompt_label.image.GetWidth() / 2,
        screen.height / 2 + 180,
        10
    );

    // Bullet count
    bullet_str = "";
    for (i = 0; i < bullets; i++) bullet_str = bullet_str + "●  ";
    if (bullet_field.sprite) bullet_field.sprite.SetOpacity(0);
    bullet_field.image  = Image.Text(bullet_str, 0.0, 0.88, 0.64, 1.0, "Sans 22");
    bullet_field.sprite = Sprite(bullet_field.image);
    bullet_field.sprite.SetPosition(
        screen.width / 2 - bullet_field.image.GetWidth() / 2,
        screen.height / 2 + 220,
        10
    );
}

fun DisplayNormal() {
    if (prompt_label.sprite) prompt_label.sprite.SetOpacity(0);
    if (bullet_field.sprite) bullet_field.sprite.SetOpacity(0);
}

Plymouth.SetDisplayPasswordFunction(DisplayPasswordPrompt);
Plymouth.SetDisplayNormalFunction(DisplayNormal);

// ── Quit transition ─────────────────────────────────────────────────────────
fun Quit() {
    // Fade everything out
    for (i = 0; i < orbit.count; i++) dots[i].sprite.SetOpacity(0);
    logo.sprite.SetOpacity(0);
    glow.sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(Quit);
