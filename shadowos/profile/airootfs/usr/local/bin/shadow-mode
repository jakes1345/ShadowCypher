#!/usr/bin/env bash
# shadow-mode — ShadowOS personality switcher.
# Hot-swap firewall, DNS, autostart, theme accent.
# Usage: shadow-mode <normal|privacy|ghost|toggle-tor|picker|status>

set -euo pipefail

MODE_DIR="/etc/shadowos/modes"
STATE_FILE="/var/lib/shadowos/current-mode"
mkdir -p "$(dirname "$STATE_FILE")"

GREEN='\033[38;2;0;224;164m'
RESET='\033[0m'
BOLD='\033[1m'

usage() {
    cat <<EOF
${BOLD}shadow-mode${RESET} — ShadowOS personality switcher

  ${GREEN}normal${RESET}      Default daily-driver
  ${GREEN}privacy${RESET}     Tor routing, MAC randomized, DNS encrypted, firejail wraps browsers
  ${GREEN}ghost${RESET}       Maximum lockdown: Tor only, every other app blocked, ephemeral
  ${GREEN}toggle-tor${RESET}  Flip Tor system-wide regardless of current mode
  ${GREEN}picker${RESET}      Show wofi mode picker
  ${GREEN}status${RESET}      Show current mode + active rules
EOF
}

current() {
    [[ -f "$STATE_FILE" ]] && cat "$STATE_FILE" || echo "normal"
}

require_root() {
    if [[ $EUID -ne 0 ]]; then
        exec sudo \
            MODE_DIR="$MODE_DIR" \
            STATE_FILE="$STATE_FILE" \
            DISPLAY="${DISPLAY:-}" \
            DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-}" \
            "$0" "$@"
    fi
}

apply_mode() {
    local mode="$1"
    local profile="$MODE_DIR/$mode"

    [[ -d "$profile" ]] || { echo "Unknown mode: $mode"; exit 1; }

    require_root "$@"

    # Revert previous mode before applying new one
    PREV_MODE=$(current)
    if [[ "$PREV_MODE" != "$mode" && -x "$MODE_DIR/$PREV_MODE/revert.sh" ]]; then
        echo -e "${GREEN}▸${RESET} reverting ${BOLD}$PREV_MODE${RESET}"
        "$MODE_DIR/$PREV_MODE/revert.sh" || true
    fi

    echo -e "${GREEN}▸${RESET} switching to ${BOLD}$mode${RESET}"

    # Run mode's apply.sh — each mode owns its own implementation
    [[ -x "$profile/apply.sh" ]] && "$profile/apply.sh"

    echo "$mode" > "$STATE_FILE"

    # Sync Waybar/Hypr theme to mode personality
    if [[ -n "${SUDO_USER:-}" ]] && [[ "$SUDO_USER" != "root" ]]; then
        uid=$(id -u "$SUDO_USER")
        sudo -u "$SUDO_USER" \
            XDG_RUNTIME_DIR="/run/user/$uid" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
            /usr/local/bin/shadowos-theme-apply "$mode" 2>/dev/null || true

        # Swap wallpaper to match mode
        declare -A MODE_WALLPAPER=(
            [normal]="shadowos-01-centaurus-a-1920x1080.png"
            [privacy]="shadowos-09-seagull-1920x1080.png"
            [ghost]="shadowos-05-collision-1920x1080.png"
        )
        WP_FILE="${MODE_WALLPAPER[$mode]:-}"
        WP_PATH="/usr/share/backgrounds/shadowos/${WP_FILE}"
        if [[ -n "$WP_FILE" && -f "$WP_PATH" ]]; then
            sudo -u "$SUDO_USER" \
                XDG_RUNTIME_DIR="/run/user/$uid" \
                WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}" \
                hyprctl hyprpaper preload "$WP_PATH" 2>/dev/null || true
            sudo -u "$SUDO_USER" \
                XDG_RUNTIME_DIR="/run/user/$uid" \
                WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}" \
                hyprctl hyprpaper wallpaper ",$WP_PATH" 2>/dev/null || true
        fi
    fi

    # Notify desktop
    if command -v notify-send >/dev/null 2>&1; then
        sudo -u "${SUDO_USER:-shadow}" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "${SUDO_USER:-shadow}")/bus" \
            notify-send -i security-high "ShadowOS" "mode → $mode" 2>/dev/null || true
    fi

    # Refresh Waybar accent
    pkill -SIGUSR2 waybar 2>/dev/null || true

    # Switch AI model for this mode
    if [[ -f /etc/shadowcypher/ai.json ]] && command -v jq >/dev/null 2>&1; then
        MODEL=$(jq -r --arg m "$mode" '.models[$m] // .default_model' /etc/shadowcypher/ai.json 2>/dev/null)
        [[ -n "$MODEL" ]] && echo "$mode → AI model: $MODEL"
    fi

    echo -e "${GREEN}✓${RESET} mode is now $mode"
}

case "${1:-}" in
    normal|privacy|ghost) apply_mode "$1" ;;
    toggle-tor)
        require_root "$@"
        if systemctl is-active --quiet tor; then
            systemctl stop tor
            echo "tor stopped"
        else
            systemctl start tor
            echo "tor started"
        fi
        ;;
    picker)
        choice=$(printf "normal\nprivacy\nghost" | wofi --dmenu --prompt="mode →")
        [[ -n "$choice" ]] && pkexec /usr/local/bin/shadow-mode "$choice"
        ;;
    status|"")
        cur=$(current)
        echo "current mode: $cur"
        echo
        if nft list tables 2>/dev/null | grep -qE 'shadow|killswitch'; then
            if [[ "$cur" == "normal" ]]; then
                echo "warning: privacy/ghost firewall rules still active — run: sudo shadow-mode normal"
                echo
            fi
        fi
        echo "tor:        $(systemctl is-active tor 2>/dev/null || echo inactive)"
        echo "dnscrypt:   $(systemctl is-active dnscrypt-proxy 2>/dev/null || echo inactive)"
        echo "firewall:   $(nft list tables 2>/dev/null | tr '\n' ' ' || echo unknown)"
        echo "mac:        $(cat /sys/class/net/*/address 2>/dev/null | head -3)"
        ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
esac
