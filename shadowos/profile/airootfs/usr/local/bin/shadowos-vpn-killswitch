#!/usr/bin/env bash
# Kill switch: block all non-VPN traffic when VPN is active.
# Uses a high-priority (priority -100) table that sits above the base firewall,
# so the base inet shadowos table stays loaded and is restored automatically
# when the kill switch is disabled.
set -e
ACTION="${1:-enable}"

if [[ "$ACTION" == "enable" ]]; then
    # Remove any stale killswitch table before adding fresh rules
    nft delete table inet killswitch 2>/dev/null || true
    nft -f - << 'NFT'
table inet killswitch {
    chain output {
        type filter hook output priority -100; policy drop;
        oifname "lo" accept
        oifname "tun*" accept
        oifname "wg*" accept
        ct state established,related accept
        # Allow VPN handshake traffic (UDP 1194 OpenVPN, UDP 51820 WireGuard)
        udp dport { 1194, 51820, 1195, 1196, 1197, 1198, 1199, 1200 } accept
        # Allow DNS to VPN servers (pre-handshake)
        udp dport 53 accept
        tcp dport 53 accept
    }
    chain input {
        type filter hook input priority -100; policy drop;
        iifname "lo" accept
        iifname "tun*" accept
        iifname "wg*" accept
        ct state established,related accept
    }
}
NFT
    echo "✓ Kill switch ACTIVE — all traffic blocked except VPN tunnel"
elif [[ "$ACTION" == "disable" ]]; then
    # Remove only the killswitch table; base firewall (inet shadowos) remains intact
    nft delete table inet killswitch 2>/dev/null || true
    echo "✓ Kill switch DISABLED — base firewall restored"
fi
