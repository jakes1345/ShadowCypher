# ── Main window ───────────────────────────────────────────────────────────────

class ShadowOSTour(Gtk.Window):
    def __init__(self):
        super().__init__(title="ShadowOS Tour")
        self.set_default_size(1100, 720)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.connect("delete-event", Gtk.main_quit)

        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self._section_ids = [s[0] for s in SECTIONS]
        self._current     = 0
        self._pages       = {}   # lazily built
        self._rows        = {}   # sidebar rows keyed by id

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(root)

        # ── Top bar ──
        topbar = Gtk.Box(spacing=12)
        topbar.set_margin_start(16)
        topbar.set_margin_end(16)
        topbar.set_margin_top(10)
        topbar.set_margin_bottom(10)

        logo = Gtk.Label()
        logo.set_markup(f'<span font_weight="900" font_size="14000" color="{ACCENT}">SHADOWOS</span>'
                        f'<span color="#334155" font_size="14000">  //  </span>'
                        f'<span color="#64748b" font_size="12000">FULL OPERATOR TOUR</span>')
        topbar.pack_start(logo, False, False, 0)

        self._progress = Gtk.ProgressBar()
        self._progress.set_hexpand(True)
        self._progress.set_valign(Gtk.Align.CENTER)
        topbar.pack_start(self._progress, True, True, 0)

        self._step_lbl = Gtk.Label()
        self._step_lbl.get_style_context().add_class("section-badge")
        topbar.pack_end(self._step_lbl, False, False, 0)

        root.pack_start(topbar, False, False, 0)

        sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        root.pack_start(sep, False, False, 0)

        # ── Body: sidebar + content ──
        body = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        body.set_position(220)
        root.pack_start(body, True, True, 0)

        # Sidebar
        sidebar_scroll = Gtk.ScrolledWindow()
        sidebar_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sidebar_scroll.get_style_context().add_class("sidebar")
        sidebar_scroll.set_size_request(220, -1)

        sidebar_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        sidebar_vbox.get_style_context().add_class("sidebar")
        sidebar_vbox.set_margin_top(8)
        sidebar_vbox.set_margin_bottom(8)

        prev_group = None
        for sec_id, icon, name, group in SECTIONS:
            if group != prev_group:
                grp_lbl = Gtk.Label(label=group)
                grp_lbl.get_style_context().add_class("sidebar-section-hdr")
                grp_lbl.set_xalign(0)
                sidebar_vbox.pack_start(grp_lbl, False, False, 0)
                prev_group = group

            row = Gtk.Box(spacing=10, orientation=Gtk.Orientation.HORIZONTAL)
            row.get_style_context().add_class("sidebar-row")
            row.set_margin_start(0)

            ico = Gtk.Label(label=icon)
            ico.get_style_context().add_class("sidebar-icon")
            row.pack_start(ico, False, False, 0)

            nm = Gtk.Label(label=name)
            nm.get_style_context().add_class("sidebar-name")
            nm.set_xalign(0)
            nm.set_hexpand(True)
            row.pack_start(nm, True, True, 0)

            eb = Gtk.EventBox()
            eb.add(row)
            _id = sec_id
            eb.connect("button-press-event", lambda _eb, _ev, sid=_id: self._goto_id(sid))

            sidebar_vbox.pack_start(eb, False, False, 0)
            self._rows[sec_id] = row

        sidebar_scroll.add(sidebar_vbox)
        body.add1(sidebar_scroll)

        # Content
        self._content_scroll = Gtk.ScrolledWindow()
        self._content_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        body.add2(self._content_scroll)

        # ── Bottom bar ──
        sep2 = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        root.pack_start(sep2, False, False, 0)

        botbar = Gtk.Box(spacing=10)
        botbar.set_margin_start(16)
        botbar.set_margin_end(16)
        botbar.set_margin_top(10)
        botbar.set_margin_bottom(10)

        self._prev_btn = Gtk.Button(label="← Previous")
        self._prev_btn.get_style_context().add_class("nav")
        self._prev_btn.connect("clicked", self._on_prev)
        botbar.pack_start(self._prev_btn, False, False, 0)

        botbar.pack_start(Gtk.Box(), True, True, 0)  # spacer

        self._section_title_lbl = Gtk.Label()
        self._section_title_lbl.set_markup(f'<span color="#334155" font_size="11000">—</span>')
        botbar.pack_start(self._section_title_lbl, False, False, 0)

        botbar.pack_start(Gtk.Box(), True, True, 0)  # spacer

        self._next_btn = Gtk.Button(label="Next →")
        self._next_btn.get_style_context().add_class("nav")
        self._next_btn.connect("clicked", self._on_next)
        botbar.pack_start(self._next_btn, False, False, 0)

        self._finish_btn = Gtk.Button(label="✓ Finish tour")
        self._finish_btn.get_style_context().add_class("finish")
        self._finish_btn.connect("clicked", lambda _: Gtk.main_quit())
        self._finish_btn.set_no_show_all(True)
        botbar.pack_start(self._finish_btn, False, False, 0)

        root.pack_start(botbar, False, False, 0)

        self._goto(0)
        self.show_all()

    # ── Navigation ────────────────────────────────────────────────────────────

    def _goto_id(self, sec_id):
        try:
            idx = self._section_ids.index(sec_id)
            self._goto(idx)
        except ValueError:
            pass

    def _goto(self, idx):
        total = len(self._section_ids)
        idx   = max(0, min(total - 1, idx))
        self._current = idx

        # Update sidebar highlight
        for sid, row in self._rows.items():
            ctx = row.get_style_context()
            if sid == self._section_ids[idx]:
                ctx.add_class("active")
            else:
                ctx.remove_class("active")

        # Build page lazily
        sec_id = self._section_ids[idx]
        if sec_id not in self._pages:
            builder = PAGE_BUILDERS.get(sec_id)
            if builder:
                content = builder()
                content.set_margin_start(32)
                content.set_margin_end(32)
                content.set_margin_top(28)
                content.set_margin_bottom(32)
                self._pages[sec_id] = content
                content.show_all()

        # Swap content
        child = self._content_scroll.get_child()
        if child:
            self._content_scroll.remove(child)
        if sec_id in self._pages:
            self._content_scroll.add(self._pages[sec_id])

        # Scroll to top
        adj = self._content_scroll.get_vadjustment()
        if adj:
            GLib.idle_add(adj.set_value, 0)

        # Update UI state
        self._progress.set_fraction((idx + 1) / total)
        self._step_lbl.set_text(f"{idx + 1} / {total}")

        sec_name = SECTIONS[idx][2]
        self._section_title_lbl.set_markup(
            f'<span color="#334155" font_size="11000">{GLib.markup_escape_text(sec_name)}</span>'
        )

        self._prev_btn.set_sensitive(idx > 0)

        is_last = idx == total - 1
        if is_last:
            self._next_btn.hide()
            self._finish_btn.show()
        else:
            self._next_btn.show()
            self._finish_btn.hide()

    def _on_next(self, _):
        self._goto(self._current + 1)

    def _on_prev(self, _):
        self._goto(self._current - 1)


def main():
    win = ShadowOSTour()
    Gtk.main()


if __name__ == "__main__":
    main()
