def _h(text, size=14, weight="bold", color="#f1f5f9"):
    lbl = Gtk.Label()
    lbl.set_markup(f'<span font_size="{size}000" font_weight="{weight}" color="{color}">{text}</span>')
    lbl.set_xalign(0)
    lbl.set_line_wrap(True)
    return lbl

def _p(text, color="#94a3b8", size=12):
    lbl = Gtk.Label(label=text)
    lbl.set_line_wrap(True)
    lbl.set_xalign(0)
    lbl.override_color(Gtk.StateFlags.NORMAL,
                       Gdk.RGBA(*[int(color.lstrip("#")[i:i+2],16)/255 for i in (0,2,4)], 1.0))
    return lbl

def _mono(text, color="#00e0a4"):
    lbl = Gtk.Label()
    lbl.set_markup(f'<span font_family="monospace" color="{color}">{GLib.markup_escape_text(text)}</span>')
    lbl.set_xalign(0)
    lbl.set_selectable(True)
    return lbl

def _sep():
    s = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
    s.set_margin_top(10)
    s.set_margin_bottom(10)
    return s

def _badge(text, css_class="mode-normal"):
    lbl = Gtk.Label(label=text)
    lbl.get_style_context().add_class("mode-badge")
    lbl.get_style_context().add_class(css_class)
    return lbl

def _section_hdr(badge, title, subtitle=""):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
    b = Gtk.Label(label=badge)
    b.get_style_context().add_class("section-badge")
    b.set_xalign(0)
    box.pack_start(b, False, False, 0)
    t = Gtk.Label(label=title)
    t.get_style_context().add_class("section-title")
    t.set_xalign(0)
    t.set_line_wrap(True)
    box.pack_start(t, False, False, 0)
    if subtitle:
        s = Gtk.Label(label=subtitle)
        s.get_style_context().add_class("section-sub")
        s.set_xalign(0)
        s.set_line_wrap(True)
        box.pack_start(s, False, False, 0)
    return box

def _keybind_table(rows):
    """rows: [(key, description), ...]"""
    grid = Gtk.Grid()
    grid.set_column_spacing(16)
    grid.set_row_spacing(8)
    for i, (key, desc) in enumerate(rows):
        k = Gtk.Label()
        k.set_markup(f'<span font_family="monospace" font_weight="bold" color="{ACCENT}">{GLib.markup_escape_text(key)}</span>')
        k.get_style_context().add_class("key-cell")
        k.set_xalign(0.5)
        k.set_hexpand(False)
        d = Gtk.Label(label=desc)
        d.get_style_context().add_class("desc-cell")
        d.set_xalign(0)
        d.set_hexpand(True)
        d.set_line_wrap(True)
        grid.attach(k, 0, i, 1, 1)
        grid.attach(d, 1, i, 1, 1)
    return grid

def _cmd_table(rows):
    """rows: [(command, description), ...]"""
    grid = Gtk.Grid()
    grid.set_column_spacing(24)
    grid.set_row_spacing(6)
    for i, (cmd, desc) in enumerate(rows):
        c = Gtk.Label()
        c.set_markup(f'<span font_family="monospace" color="{GREEN}">{GLib.markup_escape_text(cmd)}</span>')
        c.set_xalign(0)
        c.set_hexpand(False)
        c.set_selectable(True)
        d = Gtk.Label(label=desc)
        d.set_xalign(0)
        d.set_hexpand(True)
        d.set_line_wrap(True)
        markup_d = f'<span color="#64748b">{GLib.markup_escape_text(desc)}</span>'
        d.set_markup(markup_d)
        grid.attach(c, 0, i, 1, 1)
        grid.attach(d, 1, i, 1, 1)
    return grid

def _code_block(text, demo_cmd=None):
    """A styled code display, optionally with a live-run button."""
    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)

    lbl = Gtk.Label()
    lbl.set_markup(f'<span font_family="monospace" color="{GREEN}">{GLib.markup_escape_text(text)}</span>')
    lbl.set_xalign(0)
    lbl.set_selectable(True)
    lbl.set_line_wrap(False)

    frame = Gtk.Box()
    frame.get_style_context().add_class("code-block")
    frame.pack_start(lbl, True, True, 0)
    outer.pack_start(frame, False, False, 0)

    if demo_cmd:
        btn_row = Gtk.Box(spacing=8)
        run_btn = Gtk.Button(label="▶ Run demo")
        run_btn.get_style_context().add_class("try-btn")

        out_buf = Gtk.TextBuffer()
        out_view = Gtk.TextView(buffer=out_buf)
        out_view.set_editable(False)
        out_view.set_monospace(True)
        out_view.get_style_context().add_class("demo-out")
        out_scroll = Gtk.ScrolledWindow()
        out_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        out_scroll.set_max_content_height(120)
        out_scroll.add(out_view)
        out_scroll.set_no_show_all(True)

        def _run(_btn):
            out_scroll.show()
            out_buf.set_text("Running…\n")
            def _worker():
                try:
                    result = subprocess.run(
                        demo_cmd, shell=True, capture_output=True, text=True, timeout=10
                    )
                    out = (result.stdout + result.stderr).strip() or "(no output)"
                except subprocess.TimeoutExpired:
                    out = "(command timed out)"
                except Exception as e:
                    out = f"(error: {e})"
                GLib.idle_add(out_buf.set_text, out)
            threading.Thread(target=_worker, daemon=True).start()

        run_btn.connect("clicked", _run)
        btn_row.pack_start(run_btn, False, False, 0)
        outer.pack_start(btn_row, False, False, 0)
        outer.pack_start(out_scroll, False, False, 0)

    return outer

def _card(content_widget, css_class="info-card"):
    box = Gtk.Box()
    box.get_style_context().add_class(css_class)
    box.add(content_widget)
    return box

def _tip(icon, text, css_class="tip-card"):
    inner = Gtk.Box(spacing=10)
    ico = Gtk.Label(label=icon)
    ico.set_valign(Gtk.Align.START)
    inner.pack_start(ico, False, False, 0)
    lbl = Gtk.Label(label=text)
    lbl.set_line_wrap(True)
    lbl.set_xalign(0)
    lbl.set_markup(f'<span color="#94a3b8" font_size="12000">{GLib.markup_escape_text(text)}</span>')
    inner.pack_start(lbl, True, True, 0)
    box = Gtk.Box()
    box.get_style_context().add_class(css_class)
    box.add(inner)
    return box


# ── Page builders ─────────────────────────────────────────────────────────────

def build_overview():
    v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
    v.pack_start(_section_hdr("START · 01", "Welcome to ShadowOS",
        "An Arch-based OS that unifies pentest, privacy, dev, and gaming in a single hardened environment."), False, False, 0)
    v.pack_start(_sep(), False, False, 0)

    v.pack_start(_h("What makes ShadowOS different", 13, color=ACCENT), False, False, 0)

    pillars = Gtk.Grid()
    pillars.set_column_spacing(12)
    pillars.set_row_spacing(12)
    pillars.set_column_homogeneous(True)
    for col, (icon, title, desc) in enumerate([
        ("⚡", "Shadow Modes", "One command hot-swaps your entire security posture — firewall, DNS, Tor, autostart."),
        ("👻", "Ghost Mode", "8-layer anonymity stack: Tor routing, kill-switch, MAC randomization, RAM workspace, log suppression."),
        ("🎯", "Arsenal", "250+ pentest tools from BlackArch + AUR pre-installed. Nmap to Metasploit to Nuclei."),
        ("🔐", "ShadowCypher", "GTK dashboard with AI, network war-map, offensive modules, encrypted vault, C2."),
    ]):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.get_style_context().add_class("info-card")
        card.pack_start(Gtk.Label(label=icon), False, False, 0)
        card.pack_start(_h(title, 12, color="#f1f5f9"), False, False, 0)
        d = Gtk.Label(label=desc)
        d.set_line_wrap(True)
        d.set_markup(f'<span color="#64748b" font_size="11000">{GLib.markup_escape_text(desc)}</span>')
        d.set_xalign(0)
        card.pack_start(d, False, False, 0)
        pillars.attach(card, col, 0, 1, 1)
    v.pack_start(pillars, False, False, 0)

    v.pack_start(_h("Quick reference", 13, color=ACCENT), False, False, 0)
    v.pack_start(_cmd_table([
        ("shadow-mode <name>",  "Switch personality (normal/pentest/privacy/dev/ghost/undercover)"),
        ("shadow-help-me",      "Expose SSH over Tor .onion for remote debug access"),
        ("shadow-leak-test",    "Verify nothing is leaking your real identity"),
        ("shadow-update",       "Smart updater (respects current mode)"),
        ("shadowos-diag",       "Bundle all logs into a diagnostics tarball"),
        ("shadowos-install",    "Install ShadowOS to disk"),
        ("shadowcypher-autostart","Launch the ShadowCypher GTK dashboard"),
    ]), False, False, 0)
    return v


