def build_modes():
    v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
    v.pack_start(_section_hdr("DESKTOP · 03", "Shadow Modes",
        "Hot-swap your entire security posture with one command. No reboot. Instant."), False, False, 0)
    v.pack_start(_sep(), False, False, 0)

    v.pack_start(_code_block("shadow-mode <mode>       # switch mode\nshadow-mode status       # current mode + active rules\nSUPER + M               # graphical mode picker",
                              demo_cmd="shadow-mode status 2>/dev/null || echo 'run as user on the live system'"), False, False, 0)

    modes = [
        ("normal",     "🌐", "normal",     "Daily driver. dnscrypt-proxy on, ufw deny-incoming, no Tor.", "mode-normal"),
        ("dev",        "⚡", "dev",        "Dev daemons (Docker, Podman), ports open for localhost. IDE stack.", "mode-dev"),
        ("pentest",    "🎯", "pentest",    "Scan-friendly firewall. No Tor (tools work directly). Full BlackArch arsenal active.", "mode-pentest"),
        ("privacy",    "🔒", "privacy",    "All traffic through Tor. MAC randomized. dnscrypt+Tor. For hostile networks.", "mode-privacy"),
        ("ghost",      "👻", "ghost",      "Maximum lockdown. Tor-only outbound. All ports dropped. Ephemeral session. Logs suppressed.", "mode-ghost"),
        ("undercover", "💼", "undercover", "Windows-like flat theme. Standard browser icon. Looks like a normal laptop.", "mode-undercover"),
    ]

    grid = Gtk.Grid()
    grid.set_column_spacing(12)
    grid.set_row_spacing(12)
    grid.set_column_homogeneous(True)
    for i, (cmd, icon, name, desc, css) in enumerate(modes):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.get_style_context().add_class("info-card")
        top = Gtk.Box(spacing=8, orientation=Gtk.Orientation.HORIZONTAL)
        top.pack_start(Gtk.Label(label=icon), False, False, 0)
        top.pack_start(_badge(name.upper(), css), False, False, 0)
        card.pack_start(top, False, False, 0)
        d = Gtk.Label(label=desc)
        d.set_line_wrap(True)
        d.set_markup(f'<span color="#64748b" font_size="11000">{GLib.markup_escape_text(desc)}</span>')
        d.set_xalign(0)
        card.pack_start(d, False, False, 0)
        run = Gtk.Button(label=f"shadow-mode {cmd}")
        run.get_style_context().add_class("try-btn")
        _mode = cmd
        run.connect("clicked", lambda b, m=_mode: subprocess.Popen(
            ["pkexec", "shadow-mode", m], start_new_session=True))
        card.pack_start(run, False, False, 0)
        grid.attach(card, i % 3, i // 3, 1, 1)
    v.pack_start(grid, False, False, 0)

    v.pack_start(_tip("💡",
        "Switching modes is instant and non-destructive. Your open apps stay running. "
        "The Waybar accent color changes to reflect the active mode at a glance."), False, False, 0)
    return v


def build_ghost():
    v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
    v.pack_start(_section_hdr("SECURITY · 04", "Ghost Mode",
        "9-layer anonymity stack. One command to vanish. One to come back."), False, False, 0)
    v.pack_start(_sep(), False, False, 0)

    v.pack_start(_h("The 9 layers", 13, color=ACCENT), False, False, 0)
    layers = [
        ("01", "Tor transparent proxy",    "All TCP/UDP routed through Tor. No bypass possible at userspace level."),
        ("02", "iptables kill-switch",      "Tor dies → traffic drops. Your real IP never leaks, even mid-session."),
        ("03", "MAC randomization",         "New MAC address per session. Your hardware is invisible on the LAN."),
        ("04", "Hostname neutralization",   "Hostname becomes 'localhost'. Timezone forced to UTC."),
        ("05", "DNS over Tor",              "All DNS resolves through Tor's internal resolver. Zero DNS leaks."),
        ("06", "DNS leak prevention",       "/etc/resolv.conf pointed at 127.0.0.1. No fallback to ISP DNS."),
        ("07", "RAM-only workspace",        "tmpfs mount for sensitive work. Nothing written to disk in /tmp/ghost-ws/"),
        ("08", "Log suppression",           "rsyslog/syslog stopped. Audit logs paused. Minimal kernel logging."),
        ("09", "Hysteria2 QUIC",            "If configured: QUIC stealth tunnel replaces direct Tor. Harder to fingerprint."),
    ]
    for num, title, desc in layers:
        row = Gtk.Box(spacing=12)
        num_lbl = Gtk.Label()
        num_lbl.set_markup(f'<span font_family="monospace" color="{ACCENT}" font_weight="bold">{num}</span>')
        num_lbl.set_size_request(28, -1)
        row.pack_start(num_lbl, False, False, 0)
        txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        txt.pack_start(_h(title, 12, color="#f1f5f9"), False, False, 0)
        d = Gtk.Label(label=desc)
        d.set_markup(f'<span color="#64748b" font_size="11000">{GLib.markup_escape_text(desc)}</span>')
        d.set_xalign(0)
        d.set_line_wrap(True)
        txt.pack_start(d, False, False, 0)
        row.pack_start(txt, True, True, 0)
        v.pack_start(row, False, False, 0)

    v.pack_start(_sep(), False, False, 0)
    v.pack_start(_h("Commands", 13, color=ACCENT), False, False, 0)
    v.pack_start(_cmd_table([
        ("sudo shadow-mode ghost",   "Engage full ghost mode"),
        ("sudo shadow-mode normal",  "Disengage — restore all settings"),
        ("shadow-mode status",       "Show current mode + live checks"),
        ("shadow-leak-test",         "Verify Tor, DNS, MAC, hostname, TZ, browser"),
        ("shadow-help-me [min]",     "Open Tor .onion SSH for remote debug (default 60 min)"),
        ("shadow-help-me-stop",      "Close the .onion tunnel immediately"),
    ]), False, False, 0)

    v.pack_start(_code_block("shadow-leak-test", demo_cmd="shadow-leak-test 2>/dev/null || echo '(requires live system)'"), False, False, 0)

    v.pack_start(_tip("⚠️",
        "Engaging ghost mode requires root (pkexec). "
        "Disengage before suspending — the iptables kill-switch will block all traffic on resume "
        "until you disengage manually.", "warn-card"), False, False, 0)
    return v


