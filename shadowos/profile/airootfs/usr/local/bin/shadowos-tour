                ("shadow-gamescope",       "Full gamescope session — auto-detects GPU + resolution"),
                ("--hdr-enabled",          "HDR output (AMD + supported display)"),
                ("--adaptive-sync",        "VRR / FreeSync / G-Sync"),
                ("SUPER + SHIFT + F9",     "Kill gamescope, return to desktop"),
            ]),
            spacer(8),
            h3("Performance layer"),
            cmd_table([
                ("gamemoderun <game>",     "GameMode boost for a specific binary"),
                ("mangohud <game>",        "FPS / GPU / CPU overlay"),
                ("protonup-qt",            "Install custom Proton-GE versions"),
                ("wine / winetricks",      "Run Windows binaries directly"),
            ]),
        ]
    ), False, False, 0)
    p.pack_start(tip("💡",
        "shadow-gamescope auto-detects your GPU vendor (AMD/NVIDIA/Intel) and applies "
        "the right flags. It sets CPU + GPU to performance governors for the session "
        "and restores them when gamescope exits. Workspace 7 is reserved for gaming."), False, False, 0)
    return p


