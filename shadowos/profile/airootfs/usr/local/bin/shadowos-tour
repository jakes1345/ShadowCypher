def pg_modes():
    p = vbox(16)
    p.pack_start(sec_header("DESKTOP  ·  03 / 13", "Shadow Modes",
        "One command. Instant posture change. No reboot."), False, False, 0)
    p.pack_start(sep(), False, False, 0)
    p.pack_start(code_block(
        "shadow-mode <name>     # switch to a mode\n"
        "shadow-mode status     # current mode + live rule check\n"
        "SUPER + M              # graphical picker",
        demo_cmd="shadow-mode status 2>/dev/null"
    ), False, False, 0)
    p.pack_start(spacer(4), False, False, 0)

    modes = [
        ("normal",     "◎", "Normal",     "b-green",  "Daily driver. dnscrypt-proxy on, ufw deny-incoming, no Tor."),
        ("dev",        "⚡", "Dev",        "b-cyan",   "Dev daemons up, Docker/Podman accessible, local ports open."),
        ("pentest",    "◉", "Pentest",    "b-red",    "Scan-friendly firewall. Full BlackArch arsenal. No Tor (tools need direct access)."),
        ("privacy",    "◫", "Privacy",    "b-amber",  "All traffic through Tor. MAC randomized. dnscrypt+Tor. For hostile networks."),
        ("ghost",      "◯", "Ghost",      "b-ghost",  "Maximum lockdown. Tor-only outbound. All ports dropped. Logs suppressed."),
        ("undercover", "◧", "Undercover", "b-muted",  "Windows-like theme and flat taskbar. Low-profile appearance."),
    ]

    grid = Gtk.Grid()
    grid.set_column_spacing(10)
    grid.set_row_spacing(10)
    grid.set_column_homogeneous(True)
    for i, (mode, ico, name, bcls, desc) in enumerate(modes):
        c = vbox(8)
        c.get_style_context().add_class("card")
        top = hbox(8)
        top.pack_start(mlbl(f'<span font_size="16000">{ico}</span>'), False, False, 0)
        top.pack_start(badge(name.upper(), bcls), False, False, 0)
        c.pack_start(top, False, False, 0)
        c.pack_start(lbl(desc, "dim"), False, False, 0)
        btn = Gtk.Button(label=f"shadow-mode {mode}")
        btn.get_style_context().add_class("btn-mode")
        _m = mode
        btn.connect("clicked", lambda b, m=_m:
            subprocess.Popen(["pkexec", "shadow-mode", m], start_new_session=True))
        c.pack_start(btn, False, False, 0)
        grid.attach(c, i % 3, i // 3, 1, 1)
    p.pack_start(grid, False, False, 0)
    p.pack_start(tip("💡",
        "The Waybar accent colour changes with each mode — a glance tells you where you are. "
        "Switching is instant and non-destructive. Your open apps keep running."), False, False, 0)
    return p


def pg_ghost():
    p = vbox(16)
    p.pack_start(sec_header("SECURITY  ·  04 / 13", "Ghost Mode",
        "Nine-layer anonymity stack. One command to vanish, one to come back."), False, False, 0)
    p.pack_start(sep(), False, False, 0)

    layers_left = [
        ("01", "Tor transparent proxy",   "All TCP/UDP routed through Tor — no bypass at userspace level."),
        ("02", "iptables kill-switch",    "If Tor dies, traffic drops. Your real IP never leaks mid-session."),
        ("03", "MAC randomization",       "New MAC per session. Your hardware is invisible on the LAN."),
        ("04", "Hostname neutralization", "Hostname becomes 'localhost'. Timezone forced to UTC."),
        ("05", "DNS over Tor",            "All DNS resolves through Tor's internal resolver. Zero DNS leaks."),
    ]
    layers_right = [
        ("06", "DNS leak prevention",  "/etc/resolv.conf → 127.0.0.1. No fallback to ISP DNS."),
        ("07", "RAM-only workspace",   "tmpfs mount for sensitive work. Nothing written to disk."),
        ("08", "Log suppression",      "rsyslog/syslog stopped. Audit paused. Minimal kernel logging."),
        ("09", "Hysteria2 QUIC",       "If configured: QUIC stealth tunnel replaces Tor exit fingerprint."),
    ]

    def layer_rows(rows):
        b = vbox(10)
        for num, title, desc in rows:
            row = hbox(12)
            nl = mlbl(f'<span font_family="JetBrains Mono, monospace" font_weight="bold" '
                      f'color="{_G}">{num}</span>', xalign=0.5, wrap=False)
            nl.set_size_request(26, -1)
            row.pack_start(nl, False, False, 0)
            txt = vbox(2)
            txt.pack_start(h3(title, _W), False, False, 0)
            txt.pack_start(lbl(desc, "dim"), False, False, 0)
            row.pack_start(txt, True, True, 0)
            b.pack_start(row, False, False, 0)
        return b

    p.pack_start(two_col([h3("Layers 1-5"), layer_rows(layers_left)],
                         [h3("Layers 6-9"), layer_rows(layers_right)]), False, False, 0)
    p.pack_start(sep(), False, False, 0)
    p.pack_start(h3("Commands"), False, False, 0)
    p.pack_start(cmd_table([
        ("sudo shadow-mode ghost",   "Engage full ghost mode"),
        ("sudo shadow-mode normal",  "Disengage — restore all settings exactly"),
        ("shadow-mode status",       "Show mode + live Tor/DNS/MAC/firewall checks"),
        ("shadow-leak-test",         "Full anonymity audit — tests 6 leak vectors"),
        ("shadow-help-me [min]",     "Tor .onion SSH for remote debug (default 60 min)"),
        ("shadow-help-me-stop",      "Close the .onion immediately"),
    ]), False, False, 0)
    p.pack_start(code_block("shadow-leak-test",
                             demo_cmd="shadow-leak-test 2>/dev/null | head -30"), False, False, 0)
    p.pack_start(tip("⚠️",
        "Disengage before suspending. The iptables kill-switch blocks all traffic on resume "
        "until you disengage manually.", "card-warn"), False, False, 0)
    return p


