def pg_emergency():
    p = vbox(16)
    p.pack_start(sec_header("SYSTEM  ·  13 / 13", "Emergency Protocols",
        "When seconds matter. Graduated response from lock to total wipe."), False, False, 0)
    p.pack_start(sep(), False, False, 0)

    p.pack_start(tip("⚠️",
        "Everything in this section is IRREVERSIBLE. These tools exist so you can use "
        "them deliberately — not accidentally.", "card-danger"), False, False, 0)

    steps = [
        ("01  Lock",          _S,  "SUPER + L — immediate session lock."),
        ("02  Ghost Mode",    _A,  "sudo shadow-mode ghost — kill-switch on, Tor routing, logs suppressed."),
        ("03  Wipe Session",  _A,  "shadow-wipe — destroys RAM workspace, session keys, temp files."),
        ("04  ShadowCypher",  _R,  "Wraith Protocol → Spectre Flash-Wipe: destroys all keys, vault, configs, logs."),
        ("05  LUKS",          _R,  "Unencrypted drive seized = data accessible. No passphrase = cryptographic wall."),
    ]
    for step, col, desc in steps:
        row = hbox(14)
        sl = mlbl(f'<span font_family="JetBrains Mono, monospace" font_weight="bold" '
                  f'font_size="11000" color="{col}">{GLib.markup_escape_text(step)}</span>',
                  xalign=0, wrap=False)
        sl.set_size_request(160, -1)
        row.pack_start(sl, False, False, 0)
        dl = lbl(desc, "dim")
        dl.set_hexpand(True)
        row.pack_start(dl, True, True, 0)
        p.pack_start(row, False, False, 0)

    p.pack_start(sep(), False, False, 0)
    p.pack_start(h3("Commands"), False, False, 0)
    p.pack_start(cmd_table([
        ("shadow-wipe",               "Destroy RAM workspace, session keys, temp artifacts."),
        ("shadowos-ramwipe",          "Overwrite free RAM with zeros after sensitive work."),
        ("mat2 <file>",               "Strip all metadata from documents, images, PDFs."),
        ("shred -vuz <file>",         "7-pass file destruction."),
        ("sudo shadowos-apply-fixes wipe", "Full forensic cleanup: histories, logs, thumbnails, recent files."),
        ("shadow-help-me",            "Open Tor .onion SSH for trusted remote access."),
        ("shadow-help-me-stop",       "Close the .onion immediately."),
    ]), False, False, 0)
    p.pack_start(code_block("# Fast exit sequence:\n# SUPER+L  →  sudo shadow-mode ghost  →  shadow-wipe"), False, False, 0)
    return p


PAGE_FNS = {
    "overview":     pg_overview,
    "desktop":      pg_desktop,
    "modes":        pg_modes,
    "omarchy":      pg_omarchy,
    "ghost":        pg_ghost,
    "anonsurf":     pg_anonsurf,
    "amnesia":      pg_amnesia,
    "qubes":        pg_qubes,
    "pentest":      pg_pentest,
    "shadowcypher": pg_shadowcypher,
    "privacy":      pg_privacy,
    "terminal":     pg_terminal,
    "dev":          pg_dev,
    "gaming":       pg_gaming,
    "sysops":       pg_sysops,
    "install":      pg_install,
    "emergency":    pg_emergency,
}


# ── Window ────────────────────────────────────────────────────────────────────

class Tour(Gtk.Window):
    def __init__(self):
        super().__init__(title="ShadowOS Tour")
        self.set_default_size(1140, 740)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.connect("delete-event", Gtk.main_quit)

        prov = Gtk.CssProvider()
        prov.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self._ids    = [s[0] for s in SECTIONS]
        self._cur    = 0
        self._pages  = {}
        self._rows   = {}

        root = vbox(0)
        self.add(root)

        # ── Top bar ──────────────────────────────────────────────────────────
        tb = hbox(16)
        tb.get_style_context().add_class("topbar")
        tb.set_margin_start(20)
        tb.set_margin_end(20)
        tb.set_margin_top(12)
        tb.set_margin_bottom(12)

        logo_box = vbox(1)
        logo_box.pack_start(lbl("SHADOWOS", "topbar-logo", wrap=False), False, False, 0)
        logo_box.pack_start(lbl("FULL OPERATOR TOUR", "topbar-sub", wrap=False), False, False, 0)
        tb.pack_start(logo_box, False, False, 0)

        self._progress = Gtk.ProgressBar()
        self._progress.set_hexpand(True)
        self._progress.set_valign(Gtk.Align.CENTER)
        tb.pack_start(self._progress, True, True, 0)

        self._step_lbl = lbl("", "step-badge", wrap=False)
        tb.pack_end(self._step_lbl, False, False, 0)

        root.pack_start(tb, False, False, 0)

        # ── Body ─────────────────────────────────────────────────────────────
        body = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        body.set_position(234)
        root.pack_start(body, True, True, 0)

        # Sidebar
        sb_sw = Gtk.ScrolledWindow()
        sb_sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sb_sw.set_size_request(234, -1)

        sb_list = Gtk.ListBox()
        sb_list.get_style_context().add_class("sb-list")
        sb_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        sb_list.connect("row-selected", self._on_row_selected)

        prev_group = None
        for sec_id, icon, name, group in SECTIONS:
            if group != prev_group:
                grp_row = Gtk.ListBoxRow()
                grp_row.set_sensitive(False)
                grp_row.set_selectable(False)
                gl = lbl(group, "sb-group", wrap=False)
                grp_row.add(gl)
                sb_list.add(grp_row)
                prev_group = group

            row = Gtk.ListBoxRow()
            row.get_style_context().add_class("sb-row")
            h = hbox(10)
            h.set_margin_start(8)
            h.set_margin_end(8)
            h.set_margin_top(4)
            h.set_margin_bottom(4)
            il = lbl(icon, "sb-icon", wrap=False)
            nl = lbl(name, "sb-label", wrap=False)
            nl.set_hexpand(True)
            h.pack_start(il, False, False, 0)
            h.pack_start(nl, True, True, 0)
            row.add(h)
            row._sec_id = sec_id
            sb_list.add(row)
            self._rows[sec_id] = row

        sb_sw.add(sb_list)
        self._sb_list = sb_list
        body.add1(sb_sw)

        # Content
        self._content_sw = Gtk.ScrolledWindow()
        self._content_sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self._content_sw.get_style_context().add_class("content-bg")
        body.add2(self._content_sw)

        # ── Bottom bar ───────────────────────────────────────────────────────
        bb = hbox(10)
        bb.get_style_context().add_class("botbar")
        bb.set_margin_start(20)
        bb.set_margin_end(20)
        bb.set_margin_top(10)
        bb.set_margin_bottom(10)

        self._prev_btn = Gtk.Button(label="← Back")
        self._prev_btn.get_style_context().add_class("btn-nav")
        self._prev_btn.connect("clicked", lambda _: self._goto(self._cur - 1))
        bb.pack_start(self._prev_btn, False, False, 0)

        bb.pack_start(Gtk.Box(), True, True, 0)

        self._cur_label = mlbl(f'<span color="{_M}" font_size="11000">—</span>', wrap=False)
        bb.pack_start(self._cur_label, False, False, 0)

        bb.pack_start(Gtk.Box(), True, True, 0)

        self._next_btn = Gtk.Button(label="Next →")
        self._next_btn.get_style_context().add_class("btn-nav")
        self._next_btn.connect("clicked", lambda _: self._goto(self._cur + 1))
        bb.pack_start(self._next_btn, False, False, 0)

        self._finish_btn = Gtk.Button(label="✓  Done — go operate")
        self._finish_btn.get_style_context().add_class("btn-finish")
        self._finish_btn.connect("clicked", lambda _: Gtk.main_quit())
        self._finish_btn.set_no_show_all(True)
        bb.pack_start(self._finish_btn, False, False, 0)

        root.pack_start(bb, False, False, 0)

        self._goto(0)
        self.show_all()

    def _on_row_selected(self, lb, row):
        if row and hasattr(row, "_sec_id"):
            idx = self._ids.index(row._sec_id)
            if idx != self._cur:
                self._cur = idx
                self._render()

    def _goto(self, idx):
        idx = max(0, min(len(self._ids) - 1, idx))
        self._cur = idx
        # Select sidebar row
        row = self._rows.get(self._ids[idx])
        if row:
            self._sb_list.select_row(row)
        self._render()

    def _render(self):
        idx    = self._cur
        total  = len(self._ids)
        sec_id = self._ids[idx]
        name   = SECTIONS[idx][2]

        # Build page lazily
        if sec_id not in self._pages:
            fn = PAGE_FNS.get(sec_id)
            if fn:
                pg = fn()
                pg.set_margin_start(36)
                pg.set_margin_end(36)
                pg.set_margin_top(32)
                pg.set_margin_bottom(40)
                pg.show_all()
                self._pages[sec_id] = pg

        # Swap content
        child = self._content_sw.get_child()
        if child:
            self._content_sw.remove(child)
        if sec_id in self._pages:
            self._content_sw.add(self._pages[sec_id])

        GLib.idle_add(self._content_sw.get_vadjustment().set_value, 0)

        self._progress.set_fraction((idx + 1) / total)
        self._step_lbl.set_text(f"{idx + 1}  /  {total}")
        self._cur_label.set_markup(
            f'<span color="{_M}" font_size="11000">{GLib.markup_escape_text(name)}</span>')

        self._prev_btn.set_sensitive(idx > 0)
        if idx == total - 1:
            self._next_btn.hide()
            self._finish_btn.show()
        else:
            self._next_btn.show()
            self._finish_btn.hide()


if __name__ == "__main__":
    tour = Tour()
    Gtk.main()
