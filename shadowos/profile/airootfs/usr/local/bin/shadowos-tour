#!/usr/bin/env bash
# shadowos-tour — two-minute terminal walkthrough of ShadowOS.
# Launch: SUPER+F1  or  shadowos-tour

# Not attached to a terminal (keybind exec)? Re-launch inside one.
if [[ ! -t 0 && -n "${WAYLAND_DISPLAY:-}" && -z "${SHADOWOS_TOUR_TTY:-}" ]]; then
    export SHADOWOS_TOUR_TTY=1
    command -v shadow-term >/dev/null && exec shadow-term --title "ShadowOS Tour" -e "$0"
    for term in ghostty kitty foot alacritty; do
        command -v "$term" >/dev/null && exec "$term" -e "$0"
    done
    exit 0
fi

G='\033[38;2;0;224;164m'   # ShadowCypher teal
W='\033[38;2;230;237;243m'
S='\033[38;2;141;150;160m'
D='\033[38;2;61;75;92m'
A='\033[38;2;245;158;11m'
B='\033[1m'; R='\033[0m'

STEP=0; TOTAL=6
line()   { printf "${D}%s${R}\n" "────────────────────────────────────────────────────────"; }
header() { STEP=$((STEP+1)); clear; printf "\n${G}${B}SHADOWOS TOUR${R}  ${D}%d/%d${R}\n" "$STEP" "$TOTAL"; line; printf "\n${W}${B}%s${R}\n\n" "$1"; }
pause()  { printf "\n"; line; printf "${S}press any key to continue  ·  q to quit${R} "; read -rsn1 k; [[ "$k" == q ]] && { printf "\n"; exit 0; }; }
row()    { printf "  ${G}${B}%-14s${R} %s\n" "$1" "$2"; }
svc()    { if systemctl is-active --quiet "$1" 2>/dev/null; then printf "${G}active${R}"; else printf "${S}inactive${R}"; fi; }

# ── 1. intro ─────────────────────────────────────────────────────────────────
header "What ShadowOS is"
printf "  A minimal Arch Linux desktop (Hyprland) with ShadowCypher identity.\n"
printf "  Defensive security for one person: network visibility, privacy\n"
printf "  hardening, and a curated set of tools. No telemetry. No cloud lock-in.\n\n"
printf "  ${S}Current mode:${R} ${G}${B}%s${R}\n" "$(cat /var/lib/shadowos/current-mode 2>/dev/null || echo normal)"
pause

# ── 2. modes ─────────────────────────────────────────────────────────────────
header "Three modes"
row "normal"  "daily driver — full network, all apps, no restrictions"
row "privacy" "Tor routing, encrypted DNS, MAC randomized, firejail around browsers"
row "ghost"   "maximum lockdown — Tor only, everything else blocked, ephemeral"
printf "\n  ${S}Each mode is a profile in${R} /etc/shadowos/modes/<name>/ ${S}that hot-swaps\n"
printf "  firewall rules, DNS, autostart and the theme accent. Switching back\n"
printf "  reverts cleanly — nothing persists between modes.${R}\n"
pause

# ── 3. shadow-mode ───────────────────────────────────────────────────────────
header "The shadow-mode command"
printf "  ${G}\$${R} shadow-mode ${B}status${R}        ${S}current mode + active firewall rules${R}\n"
printf "  ${G}\$${R} shadow-mode ${B}privacy${R}       ${S}switch (prompts for sudo)${R}\n"
printf "  ${G}\$${R} shadow-mode ${B}ghost${R}\n"
printf "  ${G}\$${R} shadow-mode ${B}normal${R}\n"
printf "  ${G}\$${R} shadow-mode ${B}toggle-tor${R}    ${S}flip Tor system-wide in any mode${R}\n"
printf "  ${G}\$${R} shadow-mode ${B}picker${R}        ${S}graphical picker (same as SUPER+M)${R}\n\n"
printf "  ${S}Tor status right now:${R} $(svc tor)\n"
pause

# ── 4. tools ─────────────────────────────────────────────────────────────────
header "Key tools"
row "nmap"      "map your own network — who is on it, what ports are open"
row "wireshark" "inspect traffic packet by packet (wireshark-qt)"
row "keepassxc" "offline password vault, encrypted at rest"
row "tor"       "anonymous routing — on in privacy and ghost modes"
printf "\n"
row "gnupg"     "sign and encrypt files and mail"
row "wireguard" "VPN tunnels (killswitch service included)"
row "veracrypt" "encrypted volumes"
printf "\n  ${S}Also:${R} shadow-leak-test ${S}(DNS/IP leak check)${R}  ·  shadowos-diag ${S}(system report)${R}\n"
pause

# ── 5. keybinds ──────────────────────────────────────────────────────────────
header "Keybinds"
row "SUPER+D"        "app launcher (wofi)"
row "SUPER+Return"   "terminal"
row "SUPER+M"        "mode picker"
row "SUPER+T"        "toggle Tor"
row "SUPER+B"        "browser (LibreWolf)"
row "SUPER+E"        "file manager"
row "SUPER+L"        "lock screen"
row "SUPER+Q"        "close window"
row "SUPER+F"        "fullscreen"
row "SUPER+I"        "settings"
row "SUPER+F1"       "this tour"
printf "\n  ${S}Edit:${R} ~/.config/hypr/hyprland.conf\n"
pause

# ── 6. guardian ──────────────────────────────────────────────────────────────
header "Guardian daemon"
printf "  Guardian is the ShadowCypher agent. It watches this machine and, if you\n"
printf "  link an account, reports to your dashboard. It is ${B}opt-in${R} — off until\n"
printf "  you configure it. Without it, ShadowOS is fully offline-capable.\n\n"
printf "  ${S}shadowcypher-agent.service${R}  $(svc shadowcypher-agent)\n"
printf "  ${S}guardian-api.service${R}        $(svc guardian-api)\n\n"
printf "  ${G}\$${R} guardian-status          ${S}detailed status${R}\n"
printf "  ${G}\$${R} guardian-logs            ${S}follow logs${R}\n"
printf "  ${G}\$${R} shadow-settings          ${S}link an account / re-run welcome${R}\n\n"
if [[ ! -f /home/shadow/.shadowcypher/config.json ]]; then
    printf "  ${A}not linked${R} ${S}— agent will not start until an API key is configured.${R}\n"
fi
printf "\n"; line
printf "\n  ${G}${B}That's the tour.${R} ${S}Re-run any time with${R} SUPER+F1 ${S}or${R} shadowos-tour\n\n"
printf "${S}press any key to close${R} "; read -rsn1 _; printf "\n"
