def pg_overview():
    p = vbox(16)
    p.pack_start(sec_header("START  ·  01 / 13", "Welcome, Operator.",
        "ShadowOS is a hardened Arch-based OS that unifies pentest, privacy, dev, and gaming."), False, False, 0)
    p.pack_start(sep(), False, False, 0)

    # Four pillars
    grid = Gtk.Grid()
    grid.set_column_spacing(12)
    grid.set_row_spacing(12)
    grid.set_column_homogeneous(True)
    pillars = [
        ("⟳", "Shadow Modes", "Hot-swap your entire posture in one command. Six personalities — firewall, DNS, and Tor all change instantly."),
        ("◯", "Ghost Mode", "9-layer anonymity: Tor routing, kill-switch, MAC randomization, RAM workspace, log suppression, and Hysteria2 QUIC."),
        ("◉", "Pentest Arsenal", "250+ tools from BlackArch pre-installed. Nmap, Metasploit, Nuclei, Hydra, Aircrack-ng, and everything else you need."),
        ("⬡", "ShadowCypher", "GTK dashboard: AI-powered terminal, network war-map, 29 modules, encrypted vault, C2 framework, ghost mode UI."),
    ]
    for col, (ico, t, d) in enumerate(pillars):
        c = vbox(8)
        c.get_style_context().add_class("card")
        top = hbox(8)
        top.pack_start(mlbl(f'<span font_size="18000" color="{_G}">{ico}</span>'), False, False, 0)
        top.pack_start(h3(t), False, False, 0)
        c.pack_start(top, False, False, 0)
        c.pack_start(lbl(d, "dim"), False, False, 0)
        grid.attach(c, col, 0, 1, 1)
    p.pack_start(grid, False, False, 0)

    p.pack_start(h3("Quick reference"), False, False, 0)
    p.pack_start(cmd_table([
        ("shadow-mode <name>",       "Switch personality · normal / pentest / privacy / dev / ghost / undercover"),
        ("shadow-mode status",       "Show current mode + live Tor, DNS, MAC, firewall checks"),
        ("shadow-leak-test",         "Verify nothing is leaking your real identity"),
        ("shadow-help-me [min]",     "Expose SSH over Tor .onion for secure remote access"),
        ("shadow-update",            "Smart updater — respects current mode"),
        ("shadowos-diag",            "Bundle all logs into a diagnostics tarball"),
        ("shadowos-install",         "Install ShadowOS to disk"),
        ("shadowcypher-autostart",   "Launch the ShadowCypher security platform"),
    ]), False, False, 0)
    return p


