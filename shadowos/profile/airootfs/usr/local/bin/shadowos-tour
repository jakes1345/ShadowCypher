# ── Helpers ───────────────────────────────────────────────────────────────────

def lbl(text, css="body", xalign=0.0, wrap=True, selectable=False):
    l = Gtk.Label(label=text)
    l.get_style_context().add_class(css)
    l.set_xalign(xalign)
    if wrap:
        l.set_line_wrap(True)
        l.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
    if selectable:
        l.set_selectable(True)
    return l

def mlbl(markup, xalign=0.0, wrap=True):
    l = Gtk.Label()
    l.set_markup(markup)
    l.set_xalign(xalign)
    if wrap:
        l.set_line_wrap(True)
        l.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
    return l

def sep(top=8, bot=8):
    s = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
    s.set_margin_top(top)
    s.set_margin_bottom(bot)
    return s

def vbox(spacing=0):
    return Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=spacing)

def hbox(spacing=0):
    return Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=spacing)

def spacer(h=12):
    b = Gtk.Box()
    b.set_size_request(-1, h)
    return b

def sec_header(tag, title, subtitle=""):
    b = vbox(4)
    b.pack_start(lbl(tag, "sec-tag"), False, False, 0)
    b.pack_start(lbl(title, "sec-title"), False, False, 0)
    if subtitle:
        b.pack_start(lbl(subtitle, "sec-sub"), False, False, 0)
    return b

def h3(text, color=_G):
    l = Gtk.Label()
    l.set_markup(f'<span font_weight="700" font_size="13000" color="{color}">{GLib.markup_escape_text(text)}</span>')
    l.set_xalign(0)
    return l

def code_block(text, demo_cmd=None):
    outer = vbox(8)

    inner = Gtk.Box()
    inner.get_style_context().add_class("code-wrap")
    t = Gtk.Label()
    t.set_markup(f'<span font_family="JetBrains Mono, monospace" font_size="12000" color="{_G}">'
                 f'{GLib.markup_escape_text(text)}</span>')
    t.set_xalign(0)
    t.set_selectable(True)
    t.set_line_wrap(False)
    inner.pack_start(t, True, True, 0)
    outer.pack_start(inner, False, False, 0)

    if demo_cmd:
        brow = hbox(8)
        btn  = Gtk.Button(label="▶  Run demo")
        btn.get_style_context().add_class("btn-demo")

        out_buf  = Gtk.TextBuffer()
        out_view = Gtk.TextView(buffer=out_buf)
        out_view.set_editable(False)
        out_view.get_style_context().add_class("demo-out")
        out_sw = Gtk.ScrolledWindow()
        out_sw.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        out_sw.set_max_content_height(110)
        out_sw.add(out_view)
        out_sw.set_no_show_all(True)

        def _run(_b):
            out_sw.show()
            out_buf.set_text("…")
            def _w():
                try:
                    r = subprocess.run(demo_cmd, shell=True, capture_output=True,
                                       text=True, timeout=10)
                    out = (r.stdout + r.stderr).strip() or "(no output)"
                except subprocess.TimeoutExpired:
                    out = "(timed out)"
                except Exception as e:
                    out = f"(error: {e})"
                GLib.idle_add(out_buf.set_text, out)
            threading.Thread(target=_w, daemon=True).start()

        btn.connect("clicked", _run)
        brow.pack_start(btn, False, False, 0)
        outer.pack_start(brow, False, False, 0)
        outer.pack_start(out_sw, False, False, 0)

    return outer

def key_table(rows):
    """rows: [(key_label, description)]"""
    grid = Gtk.Grid()
    grid.set_column_spacing(14)
    grid.set_row_spacing(10)
    for i, (k, d) in enumerate(rows):
        kb = Gtk.Label()
        kb.set_markup(f'<span font_family="JetBrains Mono, monospace" font_size="11000" '
                      f'font_weight="700" color="{_B}">{GLib.markup_escape_text(k)}</span>')
        kb.get_style_context().add_class("key")
        kb.set_xalign(0.5)
        kb.set_hexpand(False)

        dl = Gtk.Label(label=d)
        dl.set_xalign(0)
        dl.set_hexpand(True)
        dl.set_line_wrap(True)
        dl.get_style_context().add_class("body")

        grid.attach(kb, 0, i, 1, 1)
        grid.attach(dl, 1, i, 1, 1)
    return grid

def cmd_table(rows):
    """rows: [(command, description)]"""
    grid = Gtk.Grid()
    grid.set_column_spacing(24)
    grid.set_row_spacing(9)
    for i, (c, d) in enumerate(rows):
        cl = Gtk.Label()
        cl.set_markup(f'<span font_family="JetBrains Mono, monospace" font_size="12000" '
                      f'color="{_G}">{GLib.markup_escape_text(c)}</span>')
        cl.set_xalign(0)
        cl.set_selectable(True)
        cl.set_hexpand(False)

        dl = Gtk.Label(label=d)
        dl.set_xalign(0)
        dl.set_hexpand(True)
        dl.set_line_wrap(True)
        dl.set_markup(f'<span color="{_M}" font_size="12000">{GLib.markup_escape_text(d)}</span>')

        grid.attach(cl, 0, i, 1, 1)
        grid.attach(dl, 1, i, 1, 1)
    return grid

def card(child, css="card"):
    b = Gtk.Box()
    b.get_style_context().add_class(css)
    b.add(child)
    return b

def tip(icon, text, css="card-tip"):
    inner = hbox(10)
    il = Gtk.Label(label=icon)
    il.set_valign(Gtk.Align.START)
    inner.pack_start(il, False, False, 0)
    tl = Gtk.Label(label=text)
    tl.set_markup(f'<span color="{_S}" font_size="12000">{GLib.markup_escape_text(text)}</span>')
    tl.set_xalign(0)
    tl.set_line_wrap(True)
    tl.set_hexpand(True)
    inner.pack_start(tl, True, True, 0)
    b = Gtk.Box()
    b.get_style_context().add_class(css)
    b.add(inner)
    return b

def badge(text, css="b-green"):
    l = Gtk.Label(label=text)
    l.get_style_context().add_class("badge")
    l.get_style_context().add_class(css)
    return l

def two_col(left_widgets, right_widgets, left_expand=True, right_expand=True):
    h = hbox(20)
    lc = vbox(12)
    for w in left_widgets:
        lc.pack_start(w, False, False, 0)
    rc = vbox(12)
    for w in right_widgets:
        rc.pack_start(w, False, False, 0)
    h.pack_start(lc, left_expand, True, 0)
    h.pack_start(rc, right_expand, True, 0)
    return h


