def build_emergency():
    v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
    v.pack_start(_section_hdr("SYSTEM · 13", "Emergency Protocols",
        "When seconds matter: panic wipe, session termination, evidence destruction."), False, False, 0)
    v.pack_start(_sep(), False, False, 0)

    v.pack_start(_tip("⚠️",
        "All actions in this section are IRREVERSIBLE. "
        "Read carefully. These tools exist so you can use them deliberately — not accidentally.", "danger-card"), False, False, 0)

    v.pack_start(_h("Graduated response", 13, color=RED), False, False, 0)
    steps = [
        ("1. Lock screen",         "SUPER + L — immediate session lock. Password required to resume."),
        ("2. Engage ghost",        "sudo shadow-mode ghost — kill-switch on, Tor routing, logs suppressed."),
        ("3. Wipe session data",   "shadow-wipe — destroys RAM workspace, session keys, temp files."),
        ("4. ShadowCypher PANIC",  "Wraith Protocol → Spectre Flash-Wipe: destroys all keys, vault, configs, logs."),
        ("5. LUKS device",         "If drive is seized: without your passphrase, LUKS data is cryptographically inaccessible."),
    ]
    for step, desc in steps:
        row = Gtk.Box(spacing=12)
        s = Gtk.Label()
        s.set_markup(f'<span font_family="monospace" color="{RED}" font_weight="bold">{GLib.markup_escape_text(step)}</span>')
        s.set_xalign(0)
        s.set_size_request(220, -1)
        row.pack_start(s, False, False, 0)
        d = Gtk.Label(label=desc)
        d.set_markup(f'<span color="#64748b" font_size="12000">{GLib.markup_escape_text(desc)}</span>')
        d.set_xalign(0)
        d.set_line_wrap(True)
        d.set_hexpand(True)
        row.pack_start(d, True, True, 0)
        v.pack_start(row, False, False, 0)

    v.pack_start(_sep(), False, False, 0)
    v.pack_start(_h("Commands", 13, color=RED), False, False, 0)
    v.pack_start(_cmd_table([
        ("shadow-wipe",                "Destroy RAM workspace, session keys, and temp artifacts."),
        ("shadowos-ramwipe",           "Overwrite free RAM pages with zeros (secure after sensitive work)."),
        ("mat2 <file>",                "Strip all metadata from documents, images, PDFs."),
        ("shred -vuz <file>",          "Overwrite and delete a file (7-pass)."),
        ("sudo shadowos-apply-fixes wipe", "Full forensic cleanup: shell histories, logs, thumbnails, recent files."),
    ]), False, False, 0)

    v.pack_start(_h("Remote emergency access", 13, color=AMBER), False, False, 0)
    v.pack_start(_cmd_table([
        ("shadow-help-me",             "Opens SSH via Tor .onion — lets a trusted person access your system remotely."),
        ("shadow-help-me-stop",        "Immediately closes the .onion tunnel."),
        ("shadow-help-me 30",          "Time-limited: auto-closes after 30 minutes."),
    ]), False, False, 0)

    v.pack_start(_code_block(
        "# If you need to leave fast:\nsuper+L              # lock\n# then if needed:\nsudo shadow-mode ghost\nshadow-wipe"
    ), False, False, 0)
    return v


