#!/usr/bin/env bash
# shadowos-welcome — first-boot welcome. Runs once, stamps itself, never again.
# Launched by shadowos-welcome.service / hyprland exec-once. Offline, no installs.

STAMP="$HOME/.config/shadowos/welcome.stamp"
[[ -f "$STAMP" ]] && exit 0

# Not attached to a terminal (systemd/exec-once)? Re-launch inside one.
if [[ ! -t 0 && -n "${WAYLAND_DISPLAY:-}" && -z "${SHADOWOS_WELCOME_TTY:-}" ]]; then
    export SHADOWOS_WELCOME_TTY=1
    command -v shadow-term >/dev/null && exec shadow-term --title "Welcome to ShadowOS" -e "$0"
    for term in ghostty kitty foot alacritty; do
        command -v "$term" >/dev/null && exec "$term" -e "$0"
    done
    exit 0
fi

G='\033[38;2;0;224;164m'   # ShadowCypher teal
W='\033[38;2;230;237;243m'
S='\033[38;2;141;150;160m'
D='\033[38;2;61;75;92m'
B='\033[1m'; R='\033[0m'

line() { printf "${D}%s${R}\n" "────────────────────────────────────────────────────────"; }

clear
printf "\n${G}${B}"
cat <<'EOF'
   ███████ ██   ██  █████  ██████   ██████  ██     ██
   ██      ██   ██ ██   ██ ██   ██ ██    ██ ██     ██
   ███████ ███████ ███████ ██   ██ ██    ██ ██  █  ██
        ██ ██   ██ ██   ██ ██   ██ ██    ██ ██ ███ ██
   ███████ ██   ██ ██   ██ ██████   ██████   ███ ███
EOF
printf "${R}   ${S}ShadowCypher  ·  sovereign personal security${R}\n\n"
line
printf "\n${W}${B}Welcome.${R} ${S}ShadowOS has three modes. Pick one now, switch any time.${R}\n\n"
printf "  ${G}${B}normal${R}    daily driver — full network, all apps, no restrictions\n"
printf "  ${G}${B}privacy${R}   Tor routing, encrypted DNS, MAC randomized, sandboxed browsers\n"
printf "  ${G}${B}ghost${R}     maximum lockdown — Tor only, everything else blocked, ephemeral\n\n"
line

# ── pick a mode ──────────────────────────────────────────────────────────────
mode=""
if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wofi >/dev/null; then
    mode=$(printf "normal\nprivacy\nghost" | wofi --dmenu --prompt="default mode →" 2>/dev/null)
fi
if [[ -z "$mode" ]]; then
    printf "\n${W}Default mode${R} ${S}[normal/privacy/ghost]${R} ${G}▸${R} "
    read -r mode
fi
mode="${mode,,}"
case "$mode" in normal|privacy|ghost) ;; *) mode="normal" ;; esac

printf "\n${G}▸${R} setting mode: ${B}$mode${R}\n"
if ! shadow-mode "$mode"; then
    printf "${S}  (could not apply now — run: sudo shadow-mode $mode)${R}\n"
fi

# ── keybinds ─────────────────────────────────────────────────────────────────
printf "\n"; line
printf "\n${W}${B}Three keys to know${R}\n\n"
printf "  ${G}${B}SUPER + D${R}        app launcher\n"
printf "  ${G}${B}SUPER + Return${R}   terminal\n"
printf "  ${G}${B}SUPER + M${R}        mode picker  ${S}(or: shadow-mode <name>)${R}\n\n"
printf "  ${S}Full tour any time:${R} ${G}SUPER + F1${R}  ${S}or${R}  ${G}shadowos-tour${R}\n\n"
line

# ── stamp ────────────────────────────────────────────────────────────────────
mkdir -p "$(dirname "$STAMP")"
date -Is > "$STAMP"

printf "\n${S}Done. Press Enter to close.${R} "
read -r _
