#!/usr/bin/env bash
# Secure memory sanitization on ghost-mode shutdown.
# Runs as ExecStart in shadowos-ramwipe.service (Before=shutdown.target).
#
# Strategy (layered, degrades gracefully):
#   1. Flush kernel write buffers and drop all page/inode/dentry caches
#   2. Use secure-delete's srm/sdmem if available (3-pass DoD or Gutmann)
#   3. Fill free RAM by allocating a large tmpfs file, writing random then zero data
#   4. Explicitly clear shell histories and journal in-flight logs
#   5. Unmount ephemeral home (tmpfs evaporates on next allocation cycle)

set -u

log() { echo "[ramwipe] $*" | tee -a /var/log/shadowos-ramwipe.log; }

log "Starting secure memory sanitization..."

# ── 1. Flush kernel buffers ────────────────────────────────────────────────
sync
echo 3 > /proc/sys/vm/drop_caches
log "Kernel caches flushed"

# ── 2. sdmem (secure-delete) — most thorough ──────────────────────────────
# -l = one-pass (fast), -ll = DoD 7-pass, default = Gutmann 38-pass
# Use one-pass (-l) here; Gutmann is overkill for RAM and takes >30s
if command -v sdmem >/dev/null 2>&1; then
    log "Running sdmem (secure-delete, fast pass)..."
    sdmem -l 2>/dev/null && log "sdmem complete" || log "sdmem returned non-zero (non-fatal)"
fi

# ── 3. Fill free RAM with random then zero data ────────────────────────────
# Two-pass fill forces DRAM row refresh and overwrites remanent charge
WIPE_TMP=$(mktemp /tmp/ramwipe_fill.XXXXXX)
FREE_KB=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
# Use 80% of available RAM to avoid OOM; leave headroom for running processes
FILL_MB=$(( FREE_KB * 80 / 100 / 1024 ))
FILL_MB=$(( FILL_MB < 64 ? FILL_MB : ( FILL_MB > 4096 ? 4096 : FILL_MB ) ))

if [[ "$FILL_MB" -gt 0 ]]; then
    log "Filling ~${FILL_MB}MB free RAM (random pass)..."
    dd if=/dev/urandom of="$WIPE_TMP" bs=1M count="$FILL_MB" 2>/dev/null || true

    log "Filling ~${FILL_MB}MB free RAM (zero pass)..."
    dd if=/dev/zero   of="$WIPE_TMP" bs=1M count="$FILL_MB" conv=notrunc 2>/dev/null || true

    shred -fuz "$WIPE_TMP" 2>/dev/null || rm -f "$WIPE_TMP"
    log "RAM fill complete"
else
    log "Skipping RAM fill (insufficient free memory)"
fi

sync
echo 3 > /proc/sys/vm/drop_caches

# ── 4. Wipe shell histories and in-flight logs ────────────────────────────
for hist in /home/*/.bash_history /home/*/.zsh_history /root/.bash_history /root/.zsh_history; do
    [[ -f "$hist" ]] && shred -fuz "$hist" 2>/dev/null || true
done

# Clear systemd journal RAM buffer (won't affect persistent journal on installed systems)
journalctl --vacuum-size=0 2>/dev/null || true

# ── 5. Unmount ephemeral home if ghost mode is active ─────────────────────
if mountpoint -q /home/shadow 2>/dev/null; then
    # Zero the tmpfs before unmounting so the backing memory is cleared
    find /home/shadow -type f -exec shred -fuz {} \; 2>/dev/null || true
    umount -f /home/shadow 2>/dev/null || true
    log "Ephemeral home (tmpfs) unmounted and contents shredded"
fi

log "Memory sanitization complete."
