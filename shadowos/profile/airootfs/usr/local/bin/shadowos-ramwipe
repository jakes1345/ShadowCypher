#!/usr/bin/env bash
# shadowos-ramwipe — overwrite free RAM on shutdown (ghost mode)
# Called by shadowos-ramwipe.service (Before=shutdown.target)
# secure-delete (sdmem) is in packages.x86_64 — sdmem path always runs on ShadowOS
set -e

echo "ShadowOS: secure RAM wipe in progress..."

if command -v sdmem >/dev/null 2>&1; then
    # -f fast (1 pass), -l -l minimal (2x -l = single pass, no random)
    # Still overwrites free RAM pages with zeros — good enough for threat model
    sdmem -f -l -l
else
    # Fallback: allocate a large tmpfs file to force kernel to commit RAM pages,
    # then unlink — pages get zeroed on reuse by kernel anyway, this just flushes
    # any sensitive anonymous data out of free-page lists sooner
    TMP=$(mktemp /tmp/shadowos-wipe-XXXXXX)
    FREE_KB=$(awk '/^MemFree/ {print $2}' /proc/meminfo)
    # Write ~80% of free RAM (leave headroom so we don't OOM the shutdown process)
    WRITE_KB=$(( FREE_KB * 8 / 10 ))
    dd if=/dev/zero of="$TMP" bs=1M count=$(( WRITE_KB / 1024 )) conv=fsync 2>/dev/null || true
    rm -f "$TMP"
fi

echo "ShadowOS: RAM wipe complete."
