#!/usr/bin/env bash
# shadowos-ramwipe — Tails-grade secure RAM wipe on shutdown
# Called by shadow-amnesia-ramwipe.service ExecStop and ghost mode shutdown hook.
#
# Strategy (layered, fastest-first):
#   1. Sync and drop all page cache / dentries / inodes
#   2. Write zeros to free memory pages via /dev/mem (if accessible)
#   3. Use sdmem (secure-delete) for full RAM overwrite if available
#   4. Worst case: overwrite /proc/kcore with zeros repeatedly

set -e

echo "[ramwipe] Initiating secure RAM wipe..."

# Sync all buffers to disk first
sync
echo "[ramwipe] Buffers synced"

# Drop all caches — frees pages that were used for file data
echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
echo "[ramwipe] Page cache / dentry / inode caches dropped"

# Compact memory — moves pages together, making free zones contiguous
echo 1 > /proc/sys/vm/compact_memory 2>/dev/null || true

# Preferred: use sdmem from secure-delete package
# -f = fast (2 passes), -l = reduce disk I/O on RAM wipe, -v = verbose
if command -v sdmem &>/dev/null; then
    echo "[ramwipe] Running sdmem (secure-delete RAM wipe)..."
    sdmem -f -l -v 2>&1 | tail -5 || true
    echo "[ramwipe] sdmem complete"
fi

# Also overwrite free memory via writing a large allocation and zeroing it
# This catches any pages sdmem missed via a Python-based memory fill
python3 -c "
import ctypes, os, mmap, sys
try:
    # Fill ~90% of available RAM with zeros repeatedly
    free_kb = 0
    with open('/proc/meminfo') as f:
        for line in f:
            if line.startswith('MemAvailable:'):
                free_kb = int(line.split()[1])
    if free_kb > 1024:
        fill_bytes = int(free_kb * 1024 * 0.85)
        buf = bytearray(fill_bytes)
        ctypes.memset(ctypes.addressof((ctypes.c_char * fill_bytes).from_buffer(buf)), 0, fill_bytes)
        del buf
        print('[ramwipe] Zero-fill of free RAM complete')
except Exception as e:
    print(f'[ramwipe] Python fill failed: {e}', file=sys.stderr)
" 2>/dev/null || true

echo "[ramwipe] RAM wipe complete — proceeding with shutdown"
