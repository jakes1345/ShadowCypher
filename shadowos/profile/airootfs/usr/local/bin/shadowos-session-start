#!/usr/bin/env bash
# Hyprland session wrapper — apply GPU fallbacks before compositor starts.
# Note: deliberately NOT using set -e — a failed helper must never prevent Hyprland from starting.
set -uo pipefail

export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland
export WLR_NO_HARDWARE_CURSORS=1

# A system built from the ShadowOS ISO (the live medium, or an install from it)
# carries the canonical desktop config here. The Arch packages do not ship it,
# and on a system that only has those, a home directory is its owner's: see below.
CANON=/etc/shadowos/desktop
FROM_ISO=0
[[ -f "$CANON/hyprland.lua" ]] && FROM_ISO=1

# Switch to VT1 before starting Hyprland so the display follows the Wayland session
# instead of staying on SDDM's X greeter on VT2. Without this the user sees the
# login screen looping even though Hyprland is running fine on VT1. That is the
# ISO's SDDM setup; anywhere else the session stays on the VT it was started on.
[[ "$FROM_ISO" -eq 1 ]] && { chvt 1 2>/dev/null || true; }

# Detect VM / software-render environment once (shared by WLR_RENDERER + Hyprland tweaks)
IS_VM=0
if systemd-detect-virt --quiet 2>/dev/null; then
    IS_VM=1
elif lspci 2>/dev/null | grep -qiE 'VMware|VirtualBox|QXL|Microsoft Corporation Basic|Virtio|SVGA'; then
    IS_VM=1
fi

if [[ "$IS_VM" -eq 1 ]]; then
    # Aquamarine (Hyprland's backend) needs Vulkan or hardware GL.
    # In QEMU/VMs without GPU passthrough, force Mesa's software Vulkan (lavapipe).
    export WLR_NO_HARDWARE_CURSORS=1
    # virtio-vga / most VM GPUs don't support atomic modesetting — disable it.
    export AQ_NO_ATOMIC=1
    LVP=$(ls /usr/share/vulkan/icd.d/lvp_icd*.json 2>/dev/null | head -1)
    if [[ -n "$LVP" ]]; then
        export VK_ICD_FILENAMES="$LVP"
        export VK_DRIVER_FILES="$LVP"
        export MESA_VK_WSI_DEBUG=sw
    else
        export LIBGL_ALWAYS_SOFTWARE=1
    fi
    # AQ_DRM_DEVICES must point to the KMS card node (card0/card1), NOT the render node.
    # Render nodes (renderD128) lack display output — Aquamarine aborts if given one.
    CARD_NODE=$(ls /dev/dri/card* 2>/dev/null | head -1)
    [[ -n "$CARD_NODE" ]] && export AQ_DRM_DEVICES="$CARD_NODE"
fi

CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME:-/home/shadow}/.config}"
HYPR_DIR="$CONFIG_DIR/hypr"
WAYBAR_DIR="$CONFIG_DIR/waybar"
SKEL=/etc/skel/.config
# Written after the first deploy for this account.
STAMP="$CONFIG_DIR/shadowos/desktop.stamp"

# keep_once <file> <ours>: the first time this runs for an account, a <file>
# that holds something other than <ours> is kept as <file>.pre-shadowos, in
# case it is something the user wrote.
keep_once() {
    local file="$1" ours="$2"
    [[ ! -f "$STAMP" && -f "$file" ]] || return 0
    # sha256sum, not cmp: coreutils is on every system, diffutils is not.
    [[ "$(sha256sum < "$file")" == "$(sha256sum < "$ours" 2>/dev/null)" ]] ||
        cp -p "$file" "$file.pre-shadowos" 2>/dev/null || true
}

# deploy <canonical file> <destination>: the destination becomes the canonical file.
deploy() {
    local src="$1" dst="$2"
    [[ -f "$src" ]] || return 0
    keep_once "$dst" "$src"
    cp -f "$src" "$dst"
}

# fill <dir>...: copy from /etc/skel the files of these config directories that
# the account does not have. Nothing that already exists is touched.
fill() {
    local dir
    for dir in "$@"; do
        [[ -d "$SKEL/$dir" ]] || continue
        mkdir -p "$CONFIG_DIR/$dir"
        cp -r --update=none "$SKEL/$dir/." "$CONFIG_DIR/$dir/" 2>/dev/null || true
    done
}

# Hyprland writes its example config into a home that has none, under a banner
# that asks for it to be replaced. A hyprland.lua that is still exactly that is
# nobody's work, and does not count as a config of the user's.
untouched_default() {
    local file="$HYPR_DIR/hyprland.lua" example=/usr/share/hypr/hyprland.lua
    [[ -f "$file" && -f "$example" ]] || return 1
    grep -q 'autogenerated = true' "$file" || return 1
    [[ "$(sed '1,/autogenerated = true/d' "$file" | sed '/./,$!d' | sha256sum)" == "$(sed '/./,$!d' "$example" | sha256sum)" ]]
}

if [[ "$FROM_ISO" -eq 1 ]]; then
    # Always deploy canonical desktop config (fixes old ISO autostart on every login).
    mkdir -p "$HYPR_DIR" "$WAYBAR_DIR"
    deploy "$CANON/hyprland.lua" "$HYPR_DIR/hyprland.lua"
    for canon_file in "$CANON/waybar/"*; do
        deploy "$canon_file" "$WAYBAR_DIR/${canon_file##*/}"
    done
    # These two are written further down, at every login.
    for generated in hardware-adjustments.lua mode.lua; do
        keep_once "$HYPR_DIR/$generated" "$SKEL/hypr/$generated"
    done
    # Hyprland stopped reading the .conf format, so overrides in an earlier
    # user.conf no longer apply. Say so in the file that replaces it.
    if [[ ! -f "$HYPR_DIR/user.lua" ]] && grep -qvE '^[[:space:]]*(#|$)' "$HYPR_DIR/user.conf" 2>/dev/null; then
        cat > "$HYPR_DIR/user.lua" <<'EOF'
-- Personal Hyprland overrides — ShadowOS never overwrites this file.
-- Your earlier overrides are still in user.conf, in the format Hyprland no
-- longer reads. Rewrite the ones you want to keep here, in Lua. Example:
--   hl.monitor({ output = "DP-1", mode = "2560x1440@144", position = "0x0", scale = 1 })
--   hl.bind("SUPER + G", hl.dsp.exec_cmd("gimp"))
EOF
    fi
    # The rest of the desktop (wallpaper, lock screen, notifications, terminal,
    # launcher) comes from /etc/skel, which only reaches accounts created after
    # ShadowOS was installed. Give an older account the files it lacks.
    fill hypr waybar mako foot wofi ghostty yazi
    if [[ ! -f "$STAMP" ]]; then
        mkdir -p "${STAMP%/*}" && date -Is > "$STAMP"
    fi
else
    # The packages on somebody's own system: nothing the user wrote is replaced.
    # A home without a Hyprland config is given the ShadowOS one. Whoever has a
    # config of their own keeps it, and gets their own desktop from this session.
    if [[ ! -e "$HYPR_DIR/hyprland.lua" ]] || untouched_default; then
        rm -f "$HYPR_DIR/hyprland.lua"
        fill hypr
        # With it, the config of what it starts, each only where the account
        # has none at all: a stylesheet of ours beside a bar config of theirs
        # would restyle their bar.
        for app in waybar mako foot wofi ghostty yazi; do
            [[ -e "$CONFIG_DIR/$app" ]] || fill "$app"
        done
    fi
fi

# The rest writes files next to hyprland.lua at every login. Only for a
# hyprland.lua that loads them, which the ShadowOS one does: beside somebody's
# own config they would be files of ours in a directory of theirs.
loads() { grep -qsF "$1" "$HYPR_DIR/hyprland.lua"; }

# hyprland.lua runs user.lua when it is there; make sure there is one to find.
if loads user.lua && [[ ! -f "$HYPR_DIR/user.lua" ]]; then
    printf -- '-- Personal Hyprland overrides — ShadowOS never overwrites this file.\n' > "$HYPR_DIR/user.lua"
fi

# Re-apply the per-mode accent (border colour) for the persisted mode.
if loads mode.lua; then
    MODE_STATE=/var/lib/shadowos/current-mode
    CURRENT_MODE=$({ tr -d '[:space:]' < "$MODE_STATE"; } 2>/dev/null)
    /usr/local/bin/shadowos-theme-apply "${CURRENT_MODE:-normal}" --no-reload 2>/dev/null || true
fi

# Effects to suit the machine: none in a VM, all of them on real hardware.
HARDWARE=metal
[[ "$IS_VM" -eq 1 ]] && HARDWARE=vm
if loads hardware-adjustments.lua && [[ -f "$CANON/hardware/$HARDWARE.lua" ]]; then
    cp -f "$CANON/hardware/$HARDWARE.lua" "$HYPR_DIR/hardware-adjustments.lua"
fi

# Arch ships start-hyprland; direct Hyprland triggers the yellow warning bar.
if command -v start-hyprland >/dev/null 2>&1; then
    exec start-hyprland "$@"
fi
exec Hyprland "$@"
