#!/usr/bin/env bash
# ShadowOS first-boot one-shot.
# Runs once on first boot, then stamps /var/lib/shadowos/firstboot.stamp.
# Wired up via /etc/systemd/system/shadowos-firstboot.service (oneshot, multi-user.target).
#
# What it does:
#   1. Wait for network
#   2. Add Chaotic-AUR (for ghostty, librewolf, themes)
#   3. Install AUR-only packages via Chaotic-AUR
#   4. Install Bibata cursor
#   5. Install testssl.sh (TLS auditor)
#   6. Update mirror list with reflector
#   7. Install ShadowCypher pip deps
#   8. Kick off AI model download in background
#   9. Stamp

set -u

LOG=/var/log/shadowos-firstboot.log
STAMP=/var/lib/shadowos/firstboot.stamp

mkdir -p /var/lib/shadowos
exec >>"$LOG" 2>&1

# Skip on live ISO — cowspace is RAM-backed; package installs will OOM
if [[ -f /etc/shadowos/live-iso ]]; then
    echo "[$(date -Iseconds)] live ISO detected — skipping firstboot setup."
    exit 0
fi

if [[ -f "$STAMP" ]]; then
    echo "[$(date -Iseconds)] firstboot already ran; skipping."
    exit 0
fi

echo "════════════════════════════════════════════════════════════════"
echo "  ShadowOS first-boot — $(date -Iseconds)"
echo "════════════════════════════════════════════════════════════════"

# ── 1. Wait for network ──────────────────────────────────────────────────────
echo "[*] Waiting for network..."
for i in $(seq 1 30); do
    if getent hosts archlinux.org >/dev/null 2>&1; then
        echo "    network up after ${i}s"
        break
    fi
    sleep 2
done

ONLINE=0
if getent hosts archlinux.org >/dev/null 2>&1; then
    ONLINE=1
fi

if [[ "$ONLINE" -eq 0 ]]; then
    echo "[!] No network — skipping online setup."
    exit 0
fi

# ── 2. Add Chaotic-AUR repo ──────────────────────────────────────────────────
if ! grep -q "\[chaotic-aur\]" /etc/pacman.conf 2>/dev/null; then
    echo "[*] Adding Chaotic-AUR repository..."
    pacman-key --recv-key 3056513887B78AEB --keyserver keyserver.ubuntu.com 2>/dev/null || true
    pacman-key --lsign-key 3056513887B78AEB 2>/dev/null || true
    pacman -U --noconfirm \
        'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst' \
        'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst' \
        2>&1 | tail -5 || true
    cat >> /etc/pacman.conf << 'PACMAN'

[chaotic-aur]
Include = /etc/pacman.d/chaotic-mirrorlist
PACMAN
    echo "    Chaotic-AUR added"
fi

pacman -Sy --noconfirm 2>&1 | tail -3 || true

# ── 3. AUR-only packages via Chaotic-AUR ────────────────────────────────────
echo "[*] Installing AUR packages..."

# Ghostty — GPU-accelerated terminal
pacman -S --noconfirm --needed ghostty 2>&1 | tail -5 \
    || echo "    ghostty not in Chaotic-AUR yet — install manually: yay -S ghostty"

# Privacy browser
pacman -S --noconfirm --needed librewolf 2>&1 | tail -5 \
    || echo "    librewolf not in Chaotic-AUR — try: yay -S librewolf"

# ShadowOS theme stack
pacman -S --noconfirm --needed catppuccin-gtk-theme-mocha 2>&1 | tail -5 || true
pacman -S --noconfirm --needed wl-screenrec 2>&1 | tail -5 || true

# ── 4. Bibata cursor theme ───────────────────────────────────────────────────
if [[ ! -d /usr/share/icons/Bibata-Modern-Classic ]]; then
    echo "[*] Installing Bibata cursor theme..."
    TMPCUR=$(mktemp -d)
    if curl -fsSL -o "$TMPCUR/bibata.tar.xz" \
        "https://github.com/ful1e5/Bibata_Cursor/releases/download/v2.0.7/Bibata-Modern-Classic.tar.xz" 2>/dev/null; then
        tar -xJf "$TMPCUR/bibata.tar.xz" -C /usr/share/icons/ 2>/dev/null && echo "    Bibata installed"
    fi
    rm -rf "$TMPCUR"
fi

# ── 5. testssl.sh — TLS/SSL config auditor ──────────────────────────────────
if ! command -v testssl.sh >/dev/null; then
    echo "[*] Installing testssl.sh..."
    if git clone --depth 1 https://github.com/drwetter/testssl.sh.git \
        /opt/testssl.sh 2>&1 | tail -3; then
        ln -sf /opt/testssl.sh/testssl.sh /usr/local/bin/testssl.sh
        echo "    testssl.sh installed"
    else
        echo "    testssl.sh clone failed (skipping)"
    fi
fi

# ── 6. Update mirror list ────────────────────────────────────────────────────
echo "[*] Updating pacman mirrors..."
reflector --latest 20 --sort rate --save /etc/pacman.d/mirrorlist 2>&1 | tail -3 || true

# ── 7. ShadowCypher pip dependencies ────────────────────────────────────────
echo "[*] Installing ShadowCypher pip dependencies..."
pip install --break-system-packages --quiet --no-warn-script-location \
    "litellm>=1.0.0" \
    "argon2-cffi>=23.0.0" \
    "paramiko>=3.0.0" \
    2>&1 | tail -5 || echo "    pip install failed — some ShadowCypher features may be limited"
echo "    pip deps done"

# ── 8. AI model setup (background) ──────────────────────────────────────────
if [[ -x /usr/local/bin/shadowos-ai-setup ]]; then
    /usr/local/bin/shadowos-ai-setup &
fi

# ── 9. Stamp ─────────────────────────────────────────────────────────────────
date -Iseconds > "$STAMP"
echo "[✓] First-boot setup complete."
