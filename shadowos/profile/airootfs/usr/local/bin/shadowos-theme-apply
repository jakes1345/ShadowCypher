#!/usr/bin/env bash
# shadowos-theme-apply — sync the desktop accent to the active ShadowOS mode.
# Called by shadow-mode after a switch (as the logged-in user) and by
# shadowos-session-start at login (with --no-reload, before Hyprland starts).
#
#   normal  → ShadowCypher teal (#00E0A4)
#   privacy → amber            (#F4A261)
#   ghost   → red              (#E63946)
#
# Waybar's mode pill is styled by CSS class (see waybar/style.css), so no
# config swapping is needed — only the Hyprland border accent is written here.
set -uo pipefail

mode="${1:-normal}"
reload=1
[[ "${2:-}" == "--no-reload" ]] && reload=0

hypr="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
mkdir -p "$hypr"

case "$mode" in
    privacy) border="rgba(F4A261FF) rgba(E76F51FF) 45deg" ;;
    ghost)   border="rgba(E63946FF) rgba(9D0208FF) 45deg" ;;
    dev)     border="rgba(58A6FFFF) rgba(1F6FEBFF) 45deg" ;;
    gaming)  border="rgba(BC8CFFFF) rgba(7C3AEDFF) 45deg" ;;
    *)       mode="normal"; border="rgba(00E0A4FF) rgba(00B988FF) 45deg" ;;
esac

cat > "$hypr/mode.conf" <<EOF
# Written by shadowos-theme-apply when the ShadowOS mode changes — do not edit.
# mode: $mode
general {
    col.active_border = $border
}
EOF

if (( reload )); then
    hyprctl reload >/dev/null 2>&1 || true
    # Refresh the Waybar mode pill immediately (custom/mode uses signal 8)
    pkill -RTMIN+8 waybar 2>/dev/null || true
fi
