#!/usr/bin/env bash
# Revoke an active shadow-help-me session immediately.
set -e
if [[ $EUID -ne 0 ]]; then
    exec sudo -E "$0" "$@"
fi
CLEANUP="/var/lib/shadowos/help-me-cleanup.sh"
if [[ -x "$CLEANUP" ]]; then
    "$CLEANUP"
    rm -f "$CLEANUP"
    systemctl stop shadow-help-me-cleanup.timer 2>/dev/null || true
    echo "shadow-help-me revoked."
else
    echo "no active session."
fi
