#!/usr/bin/env bash
# shadowos-install — friendly wrapper around archinstall with ShadowOS defaults.
# Until Calamares ships from AUR (v0.4), this is the bare-metal install path.
set -e

TEAL='\033[38;2;0;224;164m'
DIM='\033[2m'
BOLD='\033[1m'
RESET='\033[0m'

clear
cat <<EOF
${TEAL}${BOLD}
   ███████ ██   ██  █████  ██████   ██████  ██     ██
   ██      ██   ██ ██   ██ ██   ██ ██    ██ ██     ██
   ███████ ███████ ███████ ██   ██ ██    ██ ██  █  ██
        ██ ██   ██ ██   ██ ██   ██ ██    ██ ██ ███ ██
   ███████ ██   ██ ██   ██ ██████   ██████   ███ ███
${RESET}
${DIM}   bare-metal installer  ·  v0.3${RESET}

You are about to install ShadowOS to a disk.

  ${BOLD}Before you continue:${RESET}
    · pick a disk that you are OK ERASING ENTIRELY
    · have an internet connection (Ethernet or Wi-Fi via nmtui)
    · pick FULL DISK ENCRYPTION (LUKS) at the disk-layout step
    · username: anything (we'll seed ShadowCypher config under that home)
    · root password: required — make it strong

EOF

read -rp "$(echo -e ${BOLD}Continue?${RESET}) [y/N] " ans
[[ "$ans" =~ ^[Yy]$ ]] || { echo "aborted."; exit 0; }

echo ""
echo -e "${BOLD}Available disks:${RESET}"
lsblk -dpno NAME,SIZE,MODEL | grep -v loop | nl -w2 -s') '
echo ""
read -rp "$(echo -e ${BOLD}Target disk${RESET} [e.g. /dev/sda, /dev/nvme0n1]: )" INSTALL_DISK
if [[ -z "$INSTALL_DISK" || ! -b "$INSTALL_DISK" ]]; then
    echo "invalid disk: $INSTALL_DISK"; exit 1
fi

echo ""
echo -e "${BOLD}Full-disk encryption (LUKS2) — strongly recommended.${RESET}"
read -rp "Enable LUKS2 encryption? [Y/n] " ENC_ANS
LUKS_ENABLED=true
[[ "$ENC_ANS" =~ ^[Nn]$ ]] && LUKS_ENABLED=false

LUKS_PASS=""
if $LUKS_ENABLED; then
    while true; do
        read -rsp "$(echo -e ${BOLD}LUKS passphrase${RESET}: )" LUKS_PASS; echo
        read -rsp "$(echo -e ${BOLD}Confirm passphrase${RESET}: )" LUKS_PASS2; echo
        [[ "$LUKS_PASS" == "$LUKS_PASS2" ]] && break
        echo "passphrases do not match — try again."
    done
fi

echo ""
read -rp "$(echo -e ${BOLD}Username${RESET} [default: shadow]: )" USERNAME
USERNAME="${USERNAME:-shadow}"

# Build dynamic archinstall config with disk and LUKS settings
TMPCONF=$(mktemp /tmp/shadowos-install-XXXX.json)
cp /etc/shadowos/install/archinstall.json "$TMPCONF"
trap "rm -f $TMPCONF" EXIT

python3 - "$TMPCONF" "$INSTALL_DISK" "$USERNAME" "$LUKS_ENABLED" "$LUKS_PASS" <<'PYEOF'
import sys, json
conf_path, disk, username, luks_str, luks_pass = sys.argv[1:]
luks = luks_str == "true"
with open(conf_path) as f:
    cfg = json.load(f)
partitions = [
    {"btrfs": [], "flags": ["Boot"], "fs_type": "fat32",
     "length": {"sector_size": None, "total_size": {"unit": "MiB", "value": 512}},
     "mount_options": [], "mountpoint": "/boot", "obj_id": "efi",
     "start": {"sector_size": None, "total_size": {"unit": "MiB", "value": 1}},
     "status": "create", "type": "primary"},
    {"btrfs": [
         {"mountpoint": "/", "name": "@"},
         {"mountpoint": "/home", "name": "@home"},
         {"mountpoint": "/.snapshots", "name": "@snapshots"},
     ],
     "flags": [], "fs_type": "btrfs",
     "length": {"sector_size": None, "total_size": {"unit": "Percent", "value": 100}},
     "mount_options": ["compress=zstd", "noatime"], "mountpoint": None,
     "obj_id": "root",
     "start": {"sector_size": None, "total_size": {"unit": "MiB", "value": 513}},
     "status": "create", "type": "primary"},
]
if luks:
    for p in partitions:
        if p["obj_id"] == "root":
            p["luks"] = {"encryption_type": "luks2", "password": luks_pass}
device_mod = {"device": disk, "partitions": partitions, "wipe": True}
cfg["disk_config"] = {"device_modifications": [device_mod]}
cfg["user_accounts"] = [{
    "!password": "changeme",
    "groups": ["wheel", "video", "audio", "games", "docker"],
    "sudo": True,
    "username": username,
}]
with open(conf_path, "w") as f:
    json.dump(cfg, f, indent=2)
PYEOF

exec sudo archinstall --config "$TMPCONF"
