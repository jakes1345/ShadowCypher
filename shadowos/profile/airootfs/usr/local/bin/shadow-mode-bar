#!/usr/bin/env bash
# shadow-mode-bar — emit the Waybar mode pill (JSON: text, class, tooltip).
# State is written by shadow-mode to /var/lib/shadowos/current-mode.
set -uo pipefail

STATE_FILE="/var/lib/shadowos/current-mode"
mode="$({ tr -d '[:space:]' < "$STATE_FILE"; } 2>/dev/null)"

case "$mode" in
    privacy)
        icon="󱇯"
        desc="Tor routing · MAC randomized · encrypted DNS"
        ;;
    ghost)
        icon="󰄷"
        desc="Maximum lockdown · Tor only · ephemeral"
        ;;
    *)
        mode="normal"
        icon="󰍳"
        desc="Daily driver · standard firewall"
        ;;
esac

printf '{"text":"%s %s","alt":"%s","class":"mode-%s","tooltip":"ShadowOS mode: %s\\n%s\\n\\nClick to switch  ·  SUPER+M"}\n' \
    "$icon" "$mode" "$mode" "$mode" "$mode" "$desc"
