#!/usr/bin/env bash
# shadow-anonsurf — system-wide Tor anonymization (Parrot AnonSurf++ reimplemented)
# More aggressive than Parrot's original:
#   • Full nftables transparent proxy (no iptables — cleaner, race-free)
#   • IPv6 hard block at kernel level (Parrot sometimes leaks v6)
#   • DNS exclusively via Tor DNSPort (no cleartext DNS fallback ever)
#   • All interfaces MAC-randomized simultaneously at start
#   • Kills all known identity-leaking daemons (avahi, cups, geoclue, colord)
#   • Timestomps system clock from Tor consensus (timing attack resistance)
#   • Leak test: verifies your exit IP is a known Tor exit node
#
# Usage: shadow-anonsurf {start|stop|status|check}

set -euo pipefail

STATE_FILE=/var/lib/shadowos/anonsurf.state
TOR_UID=$(id -u tor 2>/dev/null || echo 43)
TRANS_PORT=9040
DNS_PORT=5353

_die() { echo "✗ $*" >&2; exit 1; }
_ok()  { echo "  ✓ $*"; }
_info(){ echo "  • $*"; }

require_root() {
    [[ $EUID -eq 0 ]] || _die "Must run as root — use: sudo shadow-anonsurf $1"
}

mac_randomize_all() {
    local count=0
    for iface in $(ls /sys/class/net/ | grep -Ev '^(lo|vir|docker|br-|veth)'); do
        ip link set "$iface" down 2>/dev/null || continue
        macchanger -r "$iface" 2>/dev/null && ((count++)) || true
        ip link set "$iface" up 2>/dev/null || true
    done
    _ok "MAC addresses randomized on $count interface(s)"
}

mac_restore_all() {
    for iface in $(ls /sys/class/net/ | grep -Ev '^(lo|vir|docker|br-|veth)'); do
        ip link set "$iface" down 2>/dev/null || continue
        macchanger -p "$iface" 2>/dev/null || true
        ip link set "$iface" up 2>/dev/null || true
    done
    _ok "MAC addresses restored to hardware defaults"
}

configure_tor_transparent() {
    # Ensure Tor has TransPort + DNSPort configured
    local torrc=/etc/tor/torrc
    local needs_restart=0

    grep -q "TransPort $TRANS_PORT" "$torrc" 2>/dev/null || {
        printf '\n# AnonSurf transparent proxy\nTransPort %s\nDNSPort %s\nAutomapHostsOnResolve 1\nVirtualAddrNetworkIPv4 10.192.0.0/10\n' \
            "$TRANS_PORT" "$DNS_PORT" >> "$torrc"
        needs_restart=1
    }

    systemctl start tor
    [[ $needs_restart -eq 1 ]] && systemctl restart tor

    # Wait for Tor to bootstrap
    local waited=0
    while ! systemctl is-active --quiet tor; do
        sleep 1; ((waited++))
        [[ $waited -gt 30 ]] && _die "Tor failed to start after 30s"
    done
    _ok "Tor running (TransPort=$TRANS_PORT, DNSPort=$DNS_PORT)"
}

apply_nftables() {
    # Full transparent proxy ruleset — all traffic from non-Tor UIDs routed through Tor
    nft flush ruleset

    nft -f - << NFT
table inet anonsurf {
    # Redirect DNS → Tor DNSPort
    chain prerouting {
        type nat hook prerouting priority dstnat;
        meta skuid != $TOR_UID udp dport 53 redirect to :$DNS_PORT
        meta skuid != $TOR_UID tcp dport 53 redirect to :$DNS_PORT
        meta skuid != $TOR_UID tcp flags & (fin|syn|rst|ack) == syn redirect to :$TRANS_PORT
    }

    # Output: block everything except Tor daemon and loopback
    chain output {
        type filter hook output priority filter; policy drop;
        ct state established,related accept
        oifname "lo" accept
        meta skuid $TOR_UID accept
        # Allow LAN management (SSH still works if you need recovery)
        ip daddr 127.0.0.0/8 accept
    }
}

# Hard IPv6 block — no leak path exists
table ip6 anonsurf_v6 {
    chain input  { type filter hook input  priority filter; policy drop; }
    chain output { type filter hook output priority filter; policy drop; }
    chain forward{ type filter hook forward priority filter; policy drop; }
}
NFT
    _ok "nftables: all TCP/UDP → Tor | IPv6 fully blocked"
}

kill_leak_daemons() {
    local killed=()
    for svc in avahi-daemon cups cups-browsed geoclue colord; do
        if systemctl is-active --quiet "$svc" 2>/dev/null; then
            systemctl stop "$svc" 2>/dev/null && killed+=("$svc")
        fi
    done
    [[ ${#killed[@]} -gt 0 ]] && _ok "Stopped identity-leaking daemons: ${killed[*]}"
    _ok "No cleartext network beacons (mDNS/print/geo/colord stopped)"
}

sync_clock_tor() {
    # Pull current time from Tor consensus document — avoids NTP fingerprinting
    # Tor consensus has "valid-after" timestamp we can parse
    local consensus=/var/lib/tor/cached-microdesc-consensus
    if [[ -f "$consensus" ]]; then
        local ts
        ts=$(grep "^valid-after" "$consensus" 2>/dev/null | awk '{print $2, $3}' | head -1)
        if [[ -n "$ts" ]]; then
            date -s "$ts" >/dev/null 2>&1 || true
            _ok "System clock synchronized from Tor consensus: $ts"
            return
        fi
    fi
    _info "Tor consensus not cached yet — clock unchanged (use after 30s bootstrap)"
}

cmd_start() {
    require_root start
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  shadow-anonsurf — ENGAGING FULL ANONYMITY MODE"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    mac_randomize_all
    kill_leak_daemons
    configure_tor_transparent
    apply_nftables
    sync_clock_tor

    # Also start I2P as a secondary anonymity network
    if command -v i2pd &>/dev/null; then
        systemctl start i2pd 2>/dev/null || true
        _ok "I2P started → HTTP proxy 127.0.0.1:4444 | SOCKS 127.0.0.1:4447"
    fi

    mkdir -p /var/lib/shadowos
    echo "active" > "$STATE_FILE"

    echo ""
    echo "  ● AnonSurf is ACTIVE"
    echo "    All traffic: cleartext → Tor exit node"
    echo "    DNS: Tor DNSPort (no cleartext DNS)"
    echo "    IPv6: fully blocked"
    echo "    Run 'shadow-anonsurf check' to verify exit IP"
    echo ""
}

cmd_stop() {
    require_root stop
    echo ""
    echo "  Stopping AnonSurf..."

    nft flush ruleset
    _ok "nftables ruleset cleared — direct routing restored"

    mac_restore_all

    # Restore /etc/resolv.conf if we replaced it
    systemctl restart NetworkManager 2>/dev/null || true
    _ok "NetworkManager restarted — DNS restored"

    systemctl stop tor 2>/dev/null || true
    _ok "Tor stopped"

    rm -f "$STATE_FILE"
    echo ""
    echo "  ○ AnonSurf is STOPPED — you are routing directly"
    echo ""
}

cmd_status() {
    local active=0
    [[ -f "$STATE_FILE" ]] && active=1

    if [[ $active -eq 1 ]]; then
        echo ""
        echo "  ● AnonSurf: ACTIVE"
        echo "    Tor: $(systemctl is-active tor 2>/dev/null)"
        echo "    IPv6: $(nft list table ip6 anonsurf_v6 &>/dev/null && echo 'BLOCKED' || echo 'not blocked')"
        # Show current exit IP via Tor
        local exit_ip
        exit_ip=$(torsocks curl -s --max-time 10 https://check.torproject.org/api/ip 2>/dev/null | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('IP','?'))" 2>/dev/null || echo "checking...")
        echo "    Tor exit IP: $exit_ip"
    else
        echo ""
        echo "  ○ AnonSurf: STOPPED (direct routing)"
        local real_ip
        real_ip=$(curl -s --max-time 5 https://api.ipify.org 2>/dev/null || echo "unknown")
        echo "    Real IP: $real_ip"
    fi
    echo ""
}

cmd_check() {
    echo ""
    echo "  Checking for leaks..."
    local tor_ip
    tor_ip=$(torsocks curl -s --max-time 15 https://check.torproject.org/api/ip 2>/dev/null \
        | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('IP','?'), 'Tor:', d.get('IsTor','?'))" 2>/dev/null \
        || echo "ERROR — cannot reach Tor check endpoint")
    echo "    Exit: $tor_ip"

    # DNS leak test: should resolve through Tor
    echo "    DNS test:"
    for ns in $(torsocks dig +short TXT whoami.akamai.net 2>/dev/null | head -3); do
        echo "      DNS server: $ns"
    done
    echo ""
}

case "${1:-}" in
    start)  cmd_start  ;;
    stop)   cmd_stop   ;;
    status) cmd_status ;;
    check)  cmd_check  ;;
    *)
        echo "Usage: shadow-anonsurf {start|stop|status|check}"
        echo ""
        echo "  start   — Enable full system-wide Tor anonymization"
        echo "  stop    — Restore direct routing"
        echo "  status  — Show current state + exit IP"
        echo "  check   — Verify no DNS/IP leaks"
        exit 1
        ;;
esac
