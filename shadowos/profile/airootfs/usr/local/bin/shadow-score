#!/usr/bin/env bash
# shadow-score: ShadowOS security posture score for the Waybar module.
# Prints one line of Waybar JSON: text, alt, tooltip, class, percentage.
set -uo pipefail

score=0
details=()

# 1. Firewall (25): nftables active, or any nftables table loaded (mode tables count)
if [[ "$(systemctl is-active nftables 2>/dev/null)" == "active" ]] \
   || [[ -n "$(nft list tables 2>/dev/null)" ]]; then
    score=$((score + 25)); details+=("✓ Firewall active (+25)")
else
    details+=("✗ Firewall inactive (0/25)")
fi

# 2. Local resolver (25): a loopback nameserver in resolv.conf
if grep -qE '^[[:space:]]*nameserver[[:space:]]+127\.[0-9]+\.[0-9]+\.[0-9]+' /etc/resolv.conf 2>/dev/null; then
    score=$((score + 25)); details+=("✓ Secure local resolver (+25)")
else
    details+=("✗ External DNS direct leak risk (0/25)")
fi

# 3. MAC randomization (15): the boot service ran, or privacy/ghost mode is on
mode="$(cat /var/lib/shadowos/current-mode 2>/dev/null || true)"
if [[ "$(systemctl is-active shadowos-mac-randomize 2>/dev/null)" == "active" ]] \
   || [[ "$mode" == "privacy" || "$mode" == "ghost" ]]; then
    score=$((score + 15)); details+=("✓ MAC randomized on boot (+15)")
else
    details+=("✗ Default MAC hardware address in use (0/15)")
fi

# 4. Hardened kernel (15)
if [[ "$(uname -r | tr '[:upper:]' '[:lower:]')" == *hardened* ]]; then
    score=$((score + 15)); details+=("✓ Linux hardened kernel active (+15)")
else
    details+=("✗ Generic stock kernel active (0/15)")
fi

# 5. Tor (20)
if [[ "$(systemctl is-active tor 2>/dev/null)" == "active" ]]; then
    score=$((score + 20)); details+=("✓ Tor proxy routing available (+20)")
else
    details+=("· Tor routing inactive (0/20)")
fi

# 6. Listening ports not on loopback: -10 each, capped at -30
exposed=()
while read -r local_addr; do
    [[ -z "$local_addr" ]] && continue
    case "$local_addr" in 127.*|"[::1]"*|localhost*) continue ;; esac
    [[ "$local_addr" =~ ^(.*):([0-9]+)$ ]] && exposed+=("${BASH_REMATCH[1]}:${BASH_REMATCH[2]}")
done < <(ss -tln 2>/dev/null | awk 'NR > 1 { print $4 }')

if (( ${#exposed[@]} > 0 )); then
    penalty=$(( ${#exposed[@]} * 10 )); (( penalty > 30 )) && penalty=30
    score=$((score - penalty))
    ports="$(IFS=,; echo "${exposed[*]}" | sed 's/,/, /g')"
    details+=("✗ Exposed external ports penalty: -${penalty} (${ports})")
else
    details+=("✓ Zero external ports exposed (+0)")
fi

(( score < 0 )) && score=0
(( score > 100 )) && score=100

if   (( score >= 90 )); then rating="SECURE";  icon="🛡️"; class="secure"
elif (( score >= 60 )); then rating="GUARDED"; icon="⚠️"; class="guarded"
else                         rating="EXPOSED"; icon="🚨"; class="exposed"
fi

rule="$(printf '─%.0s' {1..40})"
tooltip="🛡️ SHADOWOS SECURITY POSTURE AUDIT
Rating: ${rating} (${score}/100)
${rule}
$(printf '%s\n' "${details[@]}")
${rule}
Audit dynamic update frequency: 10s"

jq -cn --arg text "${icon} ${score}%" --arg alt "$score" --arg tooltip "$tooltip" \
       --arg class "$class" --argjson pct "$score" \
       '{text: $text, alt: $alt, tooltip: $tooltip, class: $class, percentage: $pct}'
