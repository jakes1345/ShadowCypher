naabu                      # fast port scanner (ProjectDiscovery)
mitmproxy                  # TLS MITM
exploitdb                  # local searchsploit DB
impacket                   # AD/SMB attack suite
responder                  # LLMNR/NBT-NS poisoner
netexec                    # AD swiss-army knife (renamed from crackmapexec) — blackarch
evil-winrm                 # post-exploitation WinRM
