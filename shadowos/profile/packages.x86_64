gvfs-smb                   # samba shares
blueman                    # Bluetooth GUI
power-profiles-daemon      # CPU/battery profile switching
tlp                        # laptop power management
xdg-user-dirs              # ~/Documents etc.
xdg-utils                  # xdg-open / xdg-mime defaults
zathura                    # minimal PDF viewer (modal, vim-like)
zathura-pdf-mupdf          # PDF backend
gufw                       # firewall GUI
gnome-keyring              # secret storage for browsers/apps
libsecret                  # API for keyring
seahorse                   # GUI for the keyring
