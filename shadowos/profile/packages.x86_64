python-pipx
# AD attack chain — installed via pipx at first-boot (no AUR helper needed):
#   pipx install impacket         → full AD protocol suite (SMB/Kerberos/LDAP/DCE-RPC)
#   pipx install netexec          → network exec / lateral movement
#   pipx install certipy-ad       → AD certificate services attacks
#   pipx install evil-winrm       → (needs ruby) WinRM shell
#   pipx install bloodhound       → AD path analysis
# responder — AUR; install via: sudo pacman -S python-responder (chaotic-aur after first-boot)
sshuttle
