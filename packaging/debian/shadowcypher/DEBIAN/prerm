#!/usr/bin/env bash
set -e
systemctl stop shadowcypher.service 2>/dev/null || true
systemctl disable shadowcypher.service 2>/dev/null || true

# Remove hicolor icon entries
for size in 16 24 32 48 64 128 256; do
    rm -f "/usr/share/icons/hicolor/${size}x${size}/apps/shadowcypher.png"
done
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
fi
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications 2>/dev/null || true
fi

rm -f /etc/sudoers.d/shadowcypher
