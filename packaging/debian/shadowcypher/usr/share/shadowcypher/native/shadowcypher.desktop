#!/usr/bin/env xdg-open
[Desktop Entry]
Name=ShadowCypher
Comment=Network Admin Panel
Exec=bash -c 'REPO="${SHADOWCYPHER_ROOT:-/opt/shadowcypher}"; cd "$REPO" && python3 desktop/main.py'
Path=/opt/shadowcypher
Icon=network-workgroup
Terminal=false
Type=Application
Categories=Network;System;Monitor;
Keywords=router;admin;network;firewall;security;
StartupNotify=true
StartupWMClass=ShadowCypher
