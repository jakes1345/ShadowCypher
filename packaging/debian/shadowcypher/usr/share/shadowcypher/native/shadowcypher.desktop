#!/usr/bin/env xdg-open
[Desktop Entry]
Name=ShadowCypher
Comment=Network Admin Panel
Exec=bash -c "cd /home/jack/ShadowCypher && python3 desktop/main.py"
Path=/home/jack/ShadowCypher
Icon=network-workgroup
Terminal=false
Type=Application
Categories=Network;System;Monitor;
Keywords=router;admin;network;firewall;security;
StartupNotify=true
StartupWMClass=ShadowCypher
