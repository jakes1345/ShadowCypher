# Maintainer: ShadowCypher <admin@shadowcypher.site>
# The ShadowCypher desktop app (Qt6 C++), built from shadowcypher-qt/ in this
# checkout. CMake also installs the missions from shadowscript/ next to it.
pkgname=shadowcypher
pkgver=1.0.0
pkgrel=${SHADOWOS_PKGREL:-1}   # set by build-repo.sh; see "Versions" in README.md
pkgdesc="ShadowCypher — personal security platform: network guardian, CVE feed, encrypted mail, Ghost mode"
arch=('x86_64')
url="https://shadowcypher.site"
license=('MIT')
depends=(
    'qt6-base'
    'qt6-websockets'
    'qt6-wayland'
    'openssl'
    'polkit'
)
makedepends=('cmake' 'ninja')
optdepends=(
    'tor: Ghost mode routes traffic through Tor'
    'iptables: Ghost mode kill-switch'
    'ollama: local AI assistant'
)
options=('!debug')
source=()

build() {
    cmake -S "$startdir/../../../shadowcypher-qt" -B "$srcdir/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF \
        -Wno-dev
    cmake --build "$srcdir/build"
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"

    # The user unit the ISO runs the daemon with. Not enabled here: the app
    # starts its own daemon, and whether one should run from login is the
    # user's call (systemctl --user enable --now shadowcypher-daemon).
    install -Dm644 "$startdir/../../../shadowos/profile/airootfs/etc/systemd/user/shadowcypher-daemon.service" \
        "$pkgdir/usr/lib/systemd/user/shadowcypher-daemon.service"
}
