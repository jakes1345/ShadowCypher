# Maintainer: ShadowCypher <admin@shadowcypher.site>
# The ShadowCypher desktop app (Qt6 C++). The publish-arch workflow stages
# shadowcypher-qt/ into files/ before makepkg runs.
pkgname=shadowcypher
pkgver=1.0.0
pkgrel=1
pkgdesc="ShadowCypher — personal security platform: network guardian, CVE feed, encrypted mail, Ghost mode"
arch=('x86_64')
url="https://shadowcypher.site"
license=('MIT')
depends=(
    'qt6-base'
    'qt6-websockets'
    'qt6-wayland'
    'openssl'
    'polkit'
)
makedepends=('cmake' 'make' 'gcc' 'pkgconf')
optdepends=(
    'tor: Ghost mode routes traffic through Tor'
    'iptables: Ghost mode kill-switch'
    'ollama: local AI assistant'
)
source=()

build() {
    cmake -S "$srcdir/files/shadowcypher-qt" -B "$srcdir/build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF \
        -Wno-dev
    cmake --build "$srcdir/build" --parallel "$(nproc)"
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
