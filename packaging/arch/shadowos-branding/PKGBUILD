# Maintainer: ShadowCypher <admin@shadowcypher.site>
pkgname=shadowos-branding
pkgver=1.0
pkgrel=1
pkgdesc="ShadowOS visual identity — wallpapers, Plymouth, GRUB, SDDM themes"
arch=('any')
url="https://shadowcypher.site"
license=('MIT')
depends=('plymouth' 'grub' 'sddm')
install=shadowos-branding.install
options=('!strip')

# Read straight from shadowos/profile/airootfs in this checkout; see
# shadowos-base/PKGBUILD.
source=()
sha256sums=()

package() {
    local SRC="$startdir/../../../shadowos/profile/airootfs"
    local theme

    # Wallpapers and login backgrounds. The whole directory, so the
    # wallpaper.png and login/default.png symlinks that pick the defaults
    # arrive together with the files they point at.
    install -d "$pkgdir/usr/share/backgrounds"
    cp -a "$SRC/usr/share/backgrounds/shadowos" "$pkgdir/usr/share/backgrounds/"

    # Plymouth, GRUB and SDDM themes
    for theme in plymouth grub sddm; do
        install -d "$pkgdir/usr/share/$theme/themes"
        cp -a "$SRC/usr/share/$theme/themes/shadowos" "$pkgdir/usr/share/$theme/themes/"
    done

    chmod -R u=rwX,go=rX "$pkgdir/usr"
}
