# Maintainer: ShadowCypher <admin@shadowcypher.site>
pkgname=shadowos-base
pkgver=1.0
pkgrel=1
pkgdesc="ShadowOS core — sysctl hardening, faillock, polkit rules, mode scripts, os-release"
arch=('any')
url="https://shadowcypher.site"
license=('MIT')
depends=('bash' 'polkit' 'systemd')
backup=(
    'etc/sysctl.d/99-shadowos.conf'
    'etc/security/faillock.conf'
    'etc/os-release'
    'etc/lsb-release'
    'etc/hostname'
)
options=('!strip')

# Files are pulled from the repo at build time by ../../scripts/stage-pkg.sh
# which copies the relevant subset of profile/airootfs into $srcdir.
source=()
sha256sums=()

package() {
    # Locations are mirrored from shadowos/profile/airootfs by stage-pkg.sh
    local SRC="$srcdir/files"

    # Sysctl hardening
    install -Dm644 "$SRC/etc/sysctl.d/99-shadowos.conf" \
        "$pkgdir/etc/sysctl.d/99-shadowos.conf"

    # PAM faillock
    install -Dm644 "$SRC/etc/security/faillock.conf" \
        "$pkgdir/etc/security/faillock.conf"

    # Polkit rules
    install -Dm644 "$SRC/etc/polkit-1/rules.d/49-shadowos.rules" \
        "$pkgdir/etc/polkit-1/rules.d/49-shadowos.rules"

    # OS identity
    install -Dm644 "$SRC/etc/os-release"  "$pkgdir/etc/os-release"
    install -Dm644 "$SRC/etc/lsb-release" "$pkgdir/etc/lsb-release"
    install -Dm644 "$SRC/etc/hostname"    "$pkgdir/etc/hostname"

    # SSH hardening overlay
    install -Dm644 "$SRC/etc/ssh/sshd_config.d/shadowos.conf" \
        "$pkgdir/etc/ssh/sshd_config.d/shadowos.conf"

    # Mode scripts
    install -d "$pkgdir/etc/shadowos/modes"
    for mode in normal dev pentest privacy ghost; do
        install -Dm755 "$SRC/etc/shadowos/modes/$mode/apply.sh" \
            "$pkgdir/etc/shadowos/modes/$mode/apply.sh"
    done

    # Install config defaults
    if [ -d "$SRC/etc/shadowos/install" ]; then
        cp -r "$SRC/etc/shadowos/install" "$pkgdir/etc/shadowos/install"
    fi
}
