# Maintainer: ShadowCypher <admin@shadowcypher.site>
pkgname=shadowos-firefox-config
pkgver=1.0
pkgrel=${SHADOWOS_PKGREL:-1}   # set by build-repo.sh; see "Versions" in README.md
pkgdesc="ShadowOS Firefox privacy hardening (arkenfox-derived user.js)"
arch=('any')
url="https://shadowcypher.site"
license=('MIT')
depends=('firefox')
options=('!strip' '!debug')

# Read straight from shadowos/profile/airootfs in this checkout; see
# shadowos-base/PKGBUILD.
source=()
sha256sums=()

package() {
    # The ISO ships LibreWolf, which is not in the official repositories, and
    # keeps the hardened profile under .librewolf. The preferences are plain
    # Firefox ones, so this package installs the same profile where Firefox
    # looks for it. profiles.ini is what makes Firefox pick shadow.default
    # instead of creating a profile of its own.
    local SRC="$startdir/../../../shadowos/profile/airootfs/etc/skel/.librewolf"
    local DST="$pkgdir/etc/skel/.mozilla/firefox"

    install -Dm644 "$SRC/profiles.ini" "$DST/profiles.ini"
    install -Dm644 "$SRC/shadow.default/user.js" "$DST/shadow.default/user.js"
}
