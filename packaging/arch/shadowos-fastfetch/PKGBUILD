pkgname=shadowos-fastfetch
pkgver=1.0
pkgrel=${SHADOWOS_PKGREL:-1}   # set by build-repo.sh; see "Versions" in README.md
pkgdesc="ShadowOS fastfetch banner — ASCII logo + system snapshot at terminal login"
arch=('any')
url="https://shadowcypher.site"
license=('MIT')
depends=('fastfetch')
backup=('etc/fastfetch/shadowos.jsonc')
options=('!strip' '!debug')

# Read straight from shadowos/profile/airootfs in this checkout; see
# shadowos-base/PKGBUILD.
source=()
sha256sums=()

package() {
    local SRC="$startdir/../../../shadowos/profile/airootfs"
    install -Dm644 "$SRC/etc/fastfetch/shadowos.jsonc" \
        "$pkgdir/etc/fastfetch/shadowos.jsonc"
}
