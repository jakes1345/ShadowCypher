    "aircrack_path": "/usr/bin/aircrack-ng",
    "tcpdump_path": "/usr/bin/tcpdump"
  },
  "wordlists": {
    "default": "wordlists/rockyou.txt"
  },
  "ui": {
    "theme": "dark",
    "window_width": 1580,
    "window_height": 980
