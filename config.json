{
  "ai": {
    "model": "gemma-4-heretic:latest",
    "commander_model": "gemma-4-heretic:latest",
    "offensive_model": "gemma-4-heretic:latest",
    "coding_model": "deepseek-r1:8b",
    "api_base": "http://localhost:11434/api/generate",
    "n_ctx": 8192,
    "temperature": 0.3,
    "max_tokens": 4096
