{
  "name": "shadowcypher-api",
  "version": "0.1.0",
  "private": true,
  "description": "ShadowCypher backend API — Cloudflare Worker",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
