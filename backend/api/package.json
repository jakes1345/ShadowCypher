{
  "name": "shadowcypher-api",
  "version": "0.1.0",
  "private": true,
  "description": "ShadowCypher backend API — Cloudflare Worker",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "secrets:set": "echo 'Run: wrangler secret put SUPABASE_URL && wrangler secret put SUPABASE_SERVICE_ROLE_KEY'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260716.1",
    "@vitest/ui": "^4.1.10",
    "happy-dom": "^20.10.6",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.111.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0"
  }
}
