#!/bin/bash

# --- SHADOWCYPHER OVERLORD MASTER LAUNCHER V2 (QUANTUM_EDITION) ---
# This script initializes the unified AI environment and launches the core suite.

PROJECT_ROOT="/home/jack/ShadowCypher"
VENV_PATH="$PROJECT_ROOT/ai_engine/meta-venv"
CLAUDE_FULL="/home/jack/dev-full-claude/cli-dev"

echo -e "\033[92m[OVERLORD] Initializing ShadowCypher Integrated Engine...\033[0m"

# 1. Integrity Check: Project Path
if [ ! -d "$PROJECT_ROOT" ]; then
    echo -e "\033[91m[ERROR] Project root not found at $PROJECT_ROOT\033[0m"
    exit 1
fi

# 2. Sync the environment (Professional Auto-Repair)
if [ ! -d "$VENV_PATH" ]; then
    echo -e "\033[91m[ERROR] AI Engine Virtual Environment missing at $VENV_PATH\033[0m"
    exit 1
fi

source "$VENV_PATH/bin/activate"

# 3. Quantum Core Verification
if [ -f "$CLAUDE_FULL" ]; then
    echo -e "\033[96m[INFO] QUANTUM_CORE_DETECTED: Full 88-Feature Arsenal Active.\033[0m"
    export SHADOW_QUANTUM_PATH="$CLAUDE_FULL"
else
    echo -e "\033[93m[WARN] Quantum Core not found. Standard AI mode active.\033[0m"
fi

# 4. Export Global Tactical Variables
export PYTHONPATH=$PYTHONPATH:$PROJECT_ROOT
export COMPLETION_MODEL="ShadowSentinel-V1"

# 5. Background Services (Tor + Local Sovereign Check)
TOR_STATUS=$(systemctl is-active tor 2>/dev/null || echo "inactive")
if [ "$TOR_STATUS" != "active" ]; then
    echo -e "\033[93m[WARN] Tor is NOT active. Launching in non-anonymous mode...\033[0m"
fi

# 6. Launch Sequence
# Note: SovereignServer starts automatically inside app.py via the hub integration
echo -e "\033[92m[OVERLORD] Launching ShadowCypher Core...\033[0m"
python3 "$PROJECT_ROOT/shadowcypher/app.py" "$@"
