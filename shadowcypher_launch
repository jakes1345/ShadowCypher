#!/bin/bash
# --- SHADOWCYPHER TACTICAL BOOTLOADER v6.0 (PHASE_SIGMA) ---
# Clean, Location-Independent, and Self-Healing.

# 1. Resolve Canonical Path (Follow Symlinks)
PROJECT_ROOT="$(dirname "$(readlink -f "$0")")"
VENV_PATH="$PROJECT_ROOT/venv"
ALT_VENV="$PROJECT_ROOT/ai_engine/meta-venv"

echo -e "\033[36m[BOOT] INITIALIZING_SOVEREIGN_STACK: $PROJECT_ROOT\033[0m"

# 2. Self-Healing Compilation: Go Relay & Arsenal Primitives
function sync_native() {
    # Sync Relay
    RELAY_SRC="$PROJECT_ROOT/shadowcypher/native/relay/relay.go"
    RELAY_BIN="$PROJECT_ROOT/shadowcypher/native/relay/shadow-relay"
    if [[ ! -f "$RELAY_BIN" || "$RELAY_SRC" -nt "$RELAY_BIN" ]]; then
        echo -e "\033[90m[BUILD] Synchronizing Native Core (Go Relay)...\033[0m"
        (cd "$PROJECT_ROOT/shadowcypher/native/relay/" && go build -o shadow-relay relay.go)
    fi

    # Sync Arsenal
    PRIM_DIR="$PROJECT_ROOT/shadowcypher/arsenal/primitives"
    echo -e "\e[36m[SIGMA] Verifying Native Arsenal Primitives...\e[0m"
    # Find all main.go files in subdirectories
    find "$PRIM_DIR" -name "main.go" | while read go_file; do
        target_dir=$(dirname "$go_file")
        bin_name="$target_dir/$(basename "$target_dir")"
        if [[ ! -f "$bin_name" || "$go_file" -nt "$bin_name" ]]; then
            echo -e "  \u26a1 Compiling $(basename "$target_dir")..."
            (cd "$target_dir" && go build -o "$(basename "$target_dir")" main.go)
        fi
    done
}
sync_native

# 3. Virtual Environment Sync: Prioritize High-Fidelity Meta-Venv
if [ -d "$ALT_VENV" ]; then
    echo -e "\033[35m[INFO] NEURAL_SYNC: Using High-Fidelity Meta-Venv.\033[0m"
    source "$ALT_VENV/bin/activate"
elif [ -d "$VENV_PATH" ]; then
    source "$VENV_PATH/bin/activate"
else
    echo -e "\033[33m[WARN] Virtual environment not found. Using system python.\033[0m"
fi

# 4. Global Tactical Environment
export PYTHONPATH="$PROJECT_ROOT:$PROJECT_ROOT/ai_engine:$PYTHONPATH"
export SHADOW_PORT=8888
export TOR_STRICT=false

# 5. Quantum-Core (Local AI — runs via Ollama, no external binaries)
echo -e "\033[35m[INFO] QUANTUM_CORE: Local AI deep-analysis engine active.\033[0m"

# 6. Pre-Flight Neural Check (Ollama) — Auto-start if not running
if ! curl -s http://127.0.0.1:11434/api/tags > /dev/null 2>&1; then
    echo -e "\033[33m[NEURAL] Ollama not detected. Starting ollama serve...\033[0m"
    ollama serve > /dev/null 2>&1 &
    OLLAMA_PID=$!
    
    # Wait up to 15 seconds for Ollama to become responsive
    for i in $(seq 1 15); do
        if curl -s http://127.0.0.1:11434/api/tags > /dev/null 2>&1; then
            echo -e "\033[32m[NEURAL] Ollama online (PID: $OLLAMA_PID, waited ${i}s).\033[0m"
            break
        fi
        sleep 1
    done
    
    if ! curl -s http://127.0.0.1:11434/api/tags > /dev/null 2>&1; then
        echo -e "\033[31m[WARN] Ollama failed to start. AI features may be limited.\033[0m"
    fi
else
    echo -e "\033[32m[NEURAL] Ollama already running.\033[0m"
fi

# 7. Cleanup Trap (Graceful Shutdown)
trap 'kill $(jobs -p) 2>/dev/null; echo -e "\n\033[31m[EXIT] Tactical shutdown complete.\033[0m"; exit' EXIT

# 8. Ignition
echo -e "\e[32m[SIGMA] ShadowCypher Ignition Sequence Complete.\e[0m"
python3 "$PROJECT_ROOT/shadowcypher/app.py" "$@"
