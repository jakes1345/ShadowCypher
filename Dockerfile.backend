FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ make pkg-config libcairo2-dev libffi-dev curl && \
    rm -rf /var/lib/apt/lists/*

COPY requirements-chat.txt .
RUN pip install --no-cache-dir -r requirements-chat.txt

COPY shadowcypher/ ./shadowcypher/

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=2s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/docs || exit 1

CMD ["python", "-m", "uvicorn", "shadowcypher.main_chat:app", "--host", "0.0.0.0", "--port", "8000"]
