[Desktop Entry]
Version=2.0
Name=ShadowCypher
GenericName=Security Operations Platform
Comment=Offensive security toolkit with 7 immersive themes and local AI assistant
Exec=bash -c "cd $(dirname $(readlink -f '%k')) && ./run.sh"
Path=.
Icon=shadowcypher
Terminal=false
Type=Application
Categories=System;Security;Network;
Keywords=hacking;security;pentest;nmap;hydra;hashcat;matrix;forensics;
StartupNotify=true
StartupWMClass=org.shadowcypher.ShadowCypher
