#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# shadow-cli — ShadowCypher AI Assistant
# Powered by free-code (Claude Code) + ShadowCypher MCP tools
# ═══════════════════════════════════════════════════════════════
#
# This wraps the free-code CLI with ShadowCypher's MCP server
# auto-connected, so the AI can call all security tools natively.
#
# Usage:
#   shadow-cli                    — Interactive REPL
#   shadow-cli -p "scan my network"
#   shadow-cli -p "engage ghost mode"
#   shadow-cli -p "audit my router"
#   shadow-cli -p "check if I'm anonymous"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLI_BIN="${SHADOWCYPHER_CLI_BIN:-$(command -v claude 2>/dev/null || command -v claude-code 2>/dev/null || echo "")}"

# Check if claude/claude-code binary is available
if [ -z "$CLI_BIN" ] || [ ! -x "$CLI_BIN" ]; then
    echo "Error: claude binary not found. Install Claude Code (https://claude.ai/code) or set SHADOWCYPHER_CLI_BIN."
    exit 1
fi

# Set ShadowCypher context
export SHADOWCYPHER_ROOT="${SCRIPT_DIR}"
export SHADOWCYPHER_MCP="python3 ${SCRIPT_DIR}/shadowcypher/mcp_server.py"

# System prompt injection for security context
export CLAUDE_CODE_SYSTEM_PROMPT_APPEND="
You are shadow-cli, a sovereign AI security assistant powered by ShadowCypher.
You have access to ShadowCypher MCP tools for network scanning, ghost mode,
anonymity auditing, Tor management, trace erasing, and device security.
When the user asks about security, anonymity, or privacy, use the
shadowcypher_* tools. Be direct, technical, and operational.
"

# Launch the CLI
exec "$CLI_BIN" "$@"
