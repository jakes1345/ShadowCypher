#!/usr/bin/env bash
# Unified Cyber-Operations & SRE Agent CLI Launcher
# Targets any Linux drive, partition, or mounted filesystem

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="${SCRIPT_DIR}:${PYTHONPATH}"

exec python3 "${SCRIPT_DIR}/shadowcypher/ai/unified_operations_agent.py" "$@"
