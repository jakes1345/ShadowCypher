<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ShadowCypher</vendor>
  <vendor_url>https://shadowcypher.site</vendor_url>

  <action id="site.shadowcypher.privacy">
    <description>Turn ShadowCypher privacy mode on or off</description>
    <message>Authentication is required to change the firewall for ShadowCypher privacy mode</message>
    <icon_name>security-high</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@SC_PRIVACY_HELPER_PATH@</annotate>
  </action>
</policyconfig>
